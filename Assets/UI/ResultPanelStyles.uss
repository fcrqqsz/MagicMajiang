/* 全屏遮罩：半透明黑 */
.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
    opacity: 0; /* 初始透明，通过动画显示 */
    transition-duration: 0.3s;
}

.overlay--visible {
    opacity: 1;
}

/* 主面板：卡片样式 */
.result-panel {
    width: 800px;
    height: 950px;
    background-color: #2a2a2a;
    border-width: 4px;
    border-color: #ffd700; /* 金色边框 */
    border-radius: 20px;
    padding: 40px;
    align-items: center;
}

/* 标题：巨大的“胡”字 */
.title-text {
    font-size: 80px;
    color: #ff4444;
    -unity-font-style: bold;
    margin-bottom: 20px;
    text-shadow: 2px 2px 0px #000;
}

/* 滚动列表：显示番种详情 */
.fan-list {
    flex-grow: 1;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    margin-bottom: 20px;
    padding: 15px;
}

/* 列表项：单行番种 */
.fan-item {
    font-size: 36px;
    color: #ffffff;
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #555;
}

/* 总分显示 */
.total-score {
    font-size: 80px;
    color: #ff5252;
    -unity-font-style: bold;
    margin-bottom: 30px;
    text-shadow: 2px 2px 0px #000;
}

/* 按钮 */
.restart-btn {
    width: 250px;
    height: 80px;
    font-size: 36px;
    background-color: #4CAF50;
    color: white;
    border-radius: 10px;
}
.restart-btn:hover { background-color: #66BB6a; }

/* 全局字体修正 */
.unity-text-element {
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

/* 胡牌结算缩略牌型：暗手、胡牌张与各组副露保持单行展示 */
.winning-hand-strip {
    display: none;
    width: 100%;
    flex-shrink: 0;
    padding: 10px;
    margin-bottom: 18px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 10px;
}

.winning-hand-row {
    width: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.winning-hand-group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.winning-hand-group--separated {
    margin-left: 10px;
}

.winning-hand-tile {
    flex-shrink: 0;
    margin-right: 2px;
    background-color: #f7f3e8;
    border-width: 1px;
    border-color: #8d887d;
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.winning-hand-tile--winning {
    border-width: 3px;
    border-color: #ffd700;
}
