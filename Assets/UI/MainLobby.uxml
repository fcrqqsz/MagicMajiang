<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:Style src="MainLobbyStyles.uss" />
    <ui:VisualElement name="LobbyRoot" class="lobby-root">
        <!-- Sidebar Navigation -->
        <ui:VisualElement name="Sidebar" class="sidebar">
            <ui:Label text="Super Majiang" class="sidebar-title" />
            <ui:Button name="TabHome" text="Home" class="nav-button active-tab" />
            <ui:Button name="TabWorkshop" text="Deck Workshop" class="nav-button" />
            <ui:Button name="TabCollection" text="Collection/Shop" class="nav-button" tooltip="Coming Soon!" enable="false" style="opacity: 0.5;" />
            <ui:Button name="TabSettings" text="Settings" class="nav-button" />
        </ui:VisualElement>

        <!-- Main Content Area -->
        <ui:VisualElement name="ContentArea" class="content-area">
            
            <!-- Home View -->
            <ui:VisualElement name="ViewHome" class="view-container">
                <ui:Label name="WelcomeLabel" text="Welcome, Player" class="view-title" />
                <ui:VisualElement name="DeckSelector" class="deck-selector">
                    <ui:Button name="BtnDeckPrev" text="◀" class="deck-arrow-btn" />
                    <ui:Label name="DeckNameLabel" text="当前牌库: 标准牌库（默认）" class="view-subtitle deck-name-display" />
                    <ui:Button name="BtnDeckNext" text="▶" class="deck-arrow-btn" />
                </ui:VisualElement>
                <ui:Label name="ScoreLabel" text="异化值: 0" class="view-subtitle" />
                <ui:Button name="MatchmakingButton" text="Start Matchmaking" class="action-button" />
            </ui:VisualElement>

            <!-- Workshop View -->
            <ui:VisualElement name="ViewWorkshop" class="view-container" style="display: none;">
                <ui:Label text="Deck Workshop" class="view-title" />
                <ui:Label text="Select and build your custom mahjong deck." class="view-subtitle" />
                <!-- UI for Gacha/Cosmetic preview will go here in the future -->
                <ui:VisualElement name="DeckEditorContainer" />
            </ui:VisualElement>

            <!-- Collection View -->
            <ui:VisualElement name="ViewCollection" class="view-container" style="display: none;">
                <ui:Label text="Collection &amp; Shop" class="view-title" />
                <ui:Label text="Unlock cosmetics, gacha, and new tile skins. (Coming Soon)" class="view-subtitle" />
            </ui:VisualElement>

            <!-- Settings View -->
            <ui:VisualElement name="ViewSettings" class="view-container" style="display: none;">
                <ui:Label text="Settings" class="view-title" />
                <ui:VisualElement class="settings-group">
                    <ui:Slider name="MasterVolumeSlider" label="Master Volume" low-value="0" high-value="1" />
                    <ui:Slider name="MusicVolumeSlider" label="Music Volume" low-value="0" high-value="1" />
                    <ui:Slider name="SFXVolumeSlider" label="SFX Volume" low-value="0" high-value="1" />
                    <ui:Toggle name="DebugModeToggle" label="Debug Mode" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
