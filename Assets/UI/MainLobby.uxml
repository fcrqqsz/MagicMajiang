<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:editor="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <ui:Template name="SharedAudioSettings" src="AudioSettings.uxml" />
    <ui:Style src="MainLobbyStyles.uss" />
    <ui:Style src="RoomPanel.uss" />
    <ui:VisualElement name="LobbyRoot" class="lobby-root">
        <!-- Sidebar Navigation -->
        <ui:VisualElement name="Sidebar" class="sidebar">
            <ui:VisualElement class="sidebar-brand">
                <ui:Label text="SUPER MAJIANG" class="sidebar-title" />
                <ui:Label text="国标 ROGUELIKE" class="sidebar-tag" />
            </ui:VisualElement>
            <ui:VisualElement class="nav-group">
                <ui:Button name="TabHome" text="首页大厅" class="nav-button active-tab" />
                <ui:Button name="TabWorkshop" text="牌库工坊" class="nav-button" />
                <ui:Button name="TabCompendium" text="图鉴与规则" class="nav-button" />
                <ui:Button name="TabCollection" text="收藏与商店 (即将上线)" class="nav-button nav-button-disabled" tooltip="Coming Soon!" enable="false" style="opacity: 0.5;" />
                <ui:Button name="TabSettings" text="系统设置" class="nav-button" />
            </ui:VisualElement>
            <ui:VisualElement class="sidebar-footer">
                <ui:Label text="v12 权威协议" class="sidebar-version" />
                <ui:Label text="国标 81 番 · 异化构筑" class="sidebar-copyright" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main Content Area -->
        <ui:VisualElement name="ContentArea" class="content-area">
            
            <!-- Home View -->
            <ui:VisualElement name="ViewHome" class="view-container home-view-container">
                <!-- 顶栏：呼应房间界面 Top Bar 风格 -->
                <ui:VisualElement class="home-top-bar">
                    <ui:VisualElement class="brand-block">
                        <ui:Label text="四方牌局 · 联机大厅" class="eyebrow" />
                        <ui:Label name="WelcomeLabel" text="欢迎归来，玩家" class="welcome-title" />
                    </ui:VisualElement>
                    <ui:VisualElement class="meta-strip">
                        <ui:VisualElement class="meta-cell">
                            <ui:Label text="出战牌库" class="meta-label" />
                            <ui:Label name="HomeDeckMetaLabel" text="标准牌库（默认）" class="meta-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="meta-cell">
                            <ui:Label text="总异化值" class="meta-label" />
                            <ui:Label name="HomeAlienationMetaLabel" text="0 / 80 点" class="meta-value meta-value-gold" />
                        </ui:VisualElement>
                        <ui:VisualElement class="meta-cell">
                            <ui:Label text="当前身份" class="meta-label" />
                            <ui:Label text="真人玩家" class="meta-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="connection-block">
                        <ui:Label name="HomeConnectionGood" text="在线服务器就绪" class="connection-good" />
                        <ui:Label name="HomeConnectionSub" text="权威已同步" class="connection-sub" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 主体双栏仪表盘 -->
                <ui:VisualElement class="home-body">
                    <!-- 左栏：出战构筑与异化卡片 -->
                    <ui:VisualElement class="deck-dashboard-panel">
                        <ui:VisualElement class="section-heading">
                            <ui:Label text="出战构筑与异化" class="section-title" />
                            <ui:Label text="匹配与创建房间时使用的卡组" class="section-caption" />
                        </ui:VisualElement>

                        <ui:VisualElement class="deck-main-card">
                            <!-- 牌库轮播切换 -->
                            <ui:VisualElement name="DeckSelector" class="deck-carousel-row">
                                <ui:Button name="BtnDeckPrev" text="&lt;" class="arrow-btn" />
                                <ui:VisualElement class="deck-name-container">
                                    <ui:Label name="DeckNameLabel" text="标准牌库（默认）" class="deck-name-label" />
                                    <ui:Label name="DeckPresetBadge" text="标准档 80 预算" class="deck-preset-badge" />
                                </ui:VisualElement>
                                <ui:Button name="BtnDeckNext" text="&gt;" class="arrow-btn" />
                            </ui:VisualElement>

                            <!-- 预算指示表盘 -->
                            <ui:VisualElement class="budget-panel">
                                <ui:VisualElement class="budget-header-row">
                                    <ui:Label text="当前总异化值" class="budget-title" />
                                    <ui:Label name="ScoreLabel" text="0 / 80" class="budget-total-text" />
                                </ui:VisualElement>
                                <ui:VisualElement class="progress-track">
                                    <ui:VisualElement name="HomeAlienationFill" class="progress-fill" style="width: 0%;" />
                                </ui:VisualElement>
                                <ui:VisualElement class="budget-breakdown-row">
                                    <ui:Label name="HomeDeckCostLabel" text="34张牌库: 0点" class="breakdown-item" />
                                    <ui:Label name="HomeTalentCostLabel" text="主槽天赋: 0点" class="breakdown-item" />
                                    <ui:Label name="HomeAlienationStatusBadge" text="[合规可用]" class="breakdown-tag breakdown-valid" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- 已激活与备选天赋摘要 -->
                            <ui:VisualElement class="talents-preview-box">
                                <ui:VisualElement class="talents-preview-header">
                                    <ui:Label text="激活主天赋 (6 槽位)" class="talents-box-title" />
                                </ui:VisualElement>
                                <ui:VisualElement name="HomeActiveTalentsRow1" class="talent-chips-row" />
                                <ui:VisualElement name="HomeActiveTalentsRow2" class="talent-chips-row" />

                                <ui:VisualElement class="talents-preview-header talents-sideboard-header">
                                    <ui:Label text="中场备选 (3 槽位)" class="talents-box-title" />
                                </ui:VisualElement>
                                <ui:VisualElement name="HomeSideboardTalentsRow" class="talent-chips-row" />
                            </ui:VisualElement>

                            <!-- 前往工坊按钮 -->
                            <ui:VisualElement class="deck-action-row">
                                <ui:Button name="BtnHomeJumpWorkshop" text="前往牌库工坊编辑" class="workshop-jump-btn" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="info-note">
                            <ui:Label text="提示：所选卡组总异化值不可超过进入房间的异化档位上限。可在牌库工坊自由调整 34 张牌与 6+3 天赋。" class="info-note-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 右栏：对局配置与快速操作区 -->
                    <ui:VisualElement class="match-config-panel">
                        <!-- 规则与档位设置卡片 -->
                        <ui:VisualElement class="config-card">
                            <ui:VisualElement class="section-heading">
                                <ui:Label text="对局规则与房间配置" class="section-title" />
                                <ui:Label text="创建新房间时的预设规则" class="section-caption" />
                            </ui:VisualElement>

                            <!-- 模式轮播条 -->
                            <ui:VisualElement class="selector-container">
                                <ui:Label text="对战模式" class="field-caption" />
                                <ui:VisualElement name="GameModeSelector" class="carousel-selector-bar">
                                    <ui:Button name="BtnModePrev" text="&lt;" class="carousel-arrow-btn" />
                                    <ui:VisualElement class="carousel-content-block">
                                        <ui:VisualElement class="carousel-title-row">
                                            <ui:Label name="ModeNameLabel" text="单局对战 (Single)" class="carousel-title" />
                                            <ui:Label name="ModeScoreBadge" text="50 分起始" class="badge badge-gold" />
                                        </ui:VisualElement>
                                        <ui:Label name="ModeDescLabel" text="一小局决胜，节奏紧凑明快，完整局末结算后决出胜负" class="carousel-desc" />
                                    </ui:VisualElement>
                                    <ui:Button name="BtnModeNext" text="&gt;" class="carousel-arrow-btn" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <!-- 异化档位轮播条 -->
                            <ui:VisualElement class="selector-container selector-container-spaced">
                                <ui:Label text="房间异化档位 (预算上限)" class="field-caption" />
                                <ui:VisualElement name="RoomPresetSelector" class="carousel-selector-bar">
                                    <ui:Button name="BtnRoomPresetPrev" text="&lt;" class="carousel-arrow-btn" />
                                    <ui:VisualElement class="carousel-content-block">
                                        <ui:VisualElement class="carousel-title-row">
                                            <ui:Label name="RoomPresetLabel" text="标准 80 (Standard)" class="carousel-title" />
                                            <ui:Label name="RoomPresetBadge" text="推荐默认" class="badge badge-ready" />
                                        </ui:VisualElement>
                                        <ui:Label name="RoomPresetDescLabel" text="支持多样化策略构筑与中高阶天赋配合，战力自由且平衡" class="carousel-desc" />
                                    </ui:VisualElement>
                                    <ui:Button name="BtnRoomPresetNext" text="&gt;" class="carousel-arrow-btn" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- 快速起局卡片 -->
                        <ui:VisualElement class="action-card">
                            <ui:VisualElement class="action-heading-row">
                                <ui:Label text="快速起局" class="card-subtitle" />
                                <ui:Label text="房主手动配置 AI，四席占满即可准备" class="card-caption" />
                            </ui:VisualElement>
                            <ui:VisualElement class="action-btn-row">
                                <ui:Button name="MatchmakingButton" text="创建新房间" class="btn-create-room" />
                                <ui:Button name="BtnViewRoomList" text="浏览房间列表" class="btn-view-rooms" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- 房间号直连卡片 -->
                        <ui:VisualElement class="direct-join-card">
                            <ui:VisualElement class="action-heading-row">
                                <ui:Label text="房间号直连" class="card-subtitle" />
                                <ui:Label text="输入其他玩家分享的 4 位房间号" class="card-caption" />
                            </ui:VisualElement>
                            <ui:VisualElement class="join-input-row">
                                <ui:VisualElement class="room-input-container">
                                    <ui:TextField name="RoomIdInput" placeholder-text="输入房间号 (如 7K2M 或 R0001)" class="room-id-textfield" />
                                    <ui:Label text="[自动转大写]" class="input-auto-upper-tag" />
                                </ui:VisualElement>
                                <ui:Button name="JoinRoomButton" text="加入该房间" class="btn-join-room" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- 状态与警示栏 -->
                        <ui:VisualElement class="status-strip">
                            <ui:VisualElement class="status-indicator">
                                <ui:VisualElement class="status-dot" />
                                <ui:Label name="RoomStatusLabel" text="当前未加入房间 · 准备就绪" class="status-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- 超额阻断提示 -->
                        <ui:VisualElement name="RoomAdmissionBlocker" class="admission-blocker" style="display: none;">
                            <ui:Label text="[异化超额警示]" class="blocker-title" />
                            <ui:Label name="RoomAdmissionBlockerLabel" class="blocker-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- 房间主界面保留在大厅 UIDocument；高级编辑器使用独立 UIDocument。 -->
            <ui:VisualElement name="ViewRoom" class="room-page" style="display: none;">
                <ui:VisualElement class="room-top-bar">
                    <ui:VisualElement class="room-brand-block">
                        <ui:Label text="四方牌局" class="room-eyebrow" />
                        <ui:VisualElement class="room-title-row">
                            <ui:Label name="RoomIdLabel" text="房间 ----" class="room-page-title" />
                            <ui:Button name="RoomCopyButton" text="复制" class="room-copy-button" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="room-meta-strip">
                        <ui:VisualElement class="room-meta-cell">
                            <ui:Label text="对局模式" class="room-meta-label" />
                            <ui:Label name="RoomModeLabel" text="单局" class="room-meta-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="room-meta-cell">
                            <ui:Label text="异化档位" class="room-meta-label" />
                            <ui:Label name="RoomPresetPublicLabel" text="标准 80" class="room-meta-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="room-meta-cell">
                            <ui:Label text="当前房主" class="room-meta-label" />
                            <ui:Label name="RoomHostLabel" text="--" class="room-meta-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="room-connection-block">
                        <ui:Label name="RoomStateLabel" text="等待补齐席位" class="room-connection-good" />
                        <ui:Label name="RoomConnectionLabel" text="权威状态已同步" class="room-connection-sub" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="room-body-layout">
                    <ui:VisualElement class="room-formation-panel">
                        <ui:VisualElement class="room-section-heading">
                            <ui:Label text="四席编队" class="room-section-heading-title" />
                            <ui:Label text="房主手动配置 AI，四席占满后才能准备" class="room-section-caption" />
                        </ui:VisualElement>
                        <ui:VisualElement class="room-seat-grid">
                            <ui:VisualElement class="room-seat-grid-row">
                                <ui:VisualElement name="SeatCard0" class="room-seat-card">
                                    <ui:VisualElement class="room-seat-head">
                                        <ui:Label name="Seat0Number" text="席位 1" class="room-seat-number-new" />
                                        <ui:Label name="Seat0Name" text="空席" class="room-seat-name-new" />
                                        <ui:Label name="Seat0Badges" text="等待" class="room-seat-badges" />
                                    </ui:VisualElement>
                                    <ui:Label name="Seat0Status" text="等待真人加入或由房主添加 AI" class="room-seat-status-new" />
                                    <ui:Label name="Seat0Summary" text="不创建虚假玩家" class="room-seat-summary-new" />
                                    <ui:Button name="Seat0Action" text="添加 AI" class="room-add-ai-button" />
                                </ui:VisualElement>
                                <ui:VisualElement name="SeatCard1" class="room-seat-card room-seat-card-right">
                                    <ui:VisualElement class="room-seat-head">
                                        <ui:Label name="Seat1Number" text="席位 2" class="room-seat-number-new" />
                                        <ui:Label name="Seat1Name" text="空席" class="room-seat-name-new" />
                                        <ui:Label name="Seat1Badges" text="等待" class="room-seat-badges" />
                                    </ui:VisualElement>
                                    <ui:Label name="Seat1Status" text="等待真人加入或由房主添加 AI" class="room-seat-status-new" />
                                    <ui:Label name="Seat1Summary" text="不创建虚假玩家" class="room-seat-summary-new" />
                                    <ui:Button name="Seat1Action" text="添加 AI" class="room-add-ai-button" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="room-seat-grid-row room-seat-grid-row-bottom">
                                <ui:VisualElement name="SeatCard2" class="room-seat-card">
                                    <ui:VisualElement class="room-seat-head">
                                        <ui:Label name="Seat2Number" text="席位 3" class="room-seat-number-new" />
                                        <ui:Label name="Seat2Name" text="空席" class="room-seat-name-new" />
                                        <ui:Label name="Seat2Badges" text="等待" class="room-seat-badges" />
                                    </ui:VisualElement>
                                    <ui:Label name="Seat2Status" text="等待真人加入或由房主添加 AI" class="room-seat-status-new" />
                                    <ui:Label name="Seat2Summary" text="不创建虚假玩家" class="room-seat-summary-new" />
                                    <ui:Button name="Seat2Action" text="添加 AI" class="room-add-ai-button" />
                                </ui:VisualElement>
                                <ui:VisualElement name="SeatCard3" class="room-seat-card room-seat-card-right">
                                    <ui:VisualElement class="room-seat-head">
                                        <ui:Label name="Seat3Number" text="席位 4" class="room-seat-number-new" />
                                        <ui:Label name="Seat3Name" text="空席" class="room-seat-name-new" />
                                        <ui:Label name="Seat3Badges" text="等待" class="room-seat-badges" />
                                    </ui:VisualElement>
                                    <ui:Label name="Seat3Status" text="等待真人加入或由房主添加 AI" class="room-seat-status-new" />
                                    <ui:Label name="Seat3Summary" text="不创建虚假玩家" class="room-seat-summary-new" />
                                    <ui:Button name="Seat3Action" text="添加 AI" class="room-add-ai-button" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="room-privacy-note">
                            <ui:Label text="真人构筑保持私有；永久 AI 的 34 张牌库与 6+3 天赋向房内所有真人公开。" class="room-privacy-note-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="room-side-panel">
                        <ui:VisualElement class="room-detail-head">
                            <ui:VisualElement class="room-detail-title-block">
                                <ui:Label name="RoomDetailName" text="选择一个席位" class="room-detail-title" />
                                <ui:Label name="RoomDetailMeta" text="查看状态或配置永久 AI" class="room-detail-subtitle" />
                            </ui:VisualElement>
                            <ui:Label name="RoomDetailAccess" text="查看" class="room-detail-access" />
                        </ui:VisualElement>
                        <ui:VisualElement name="AiQuickConfig" class="room-quick-config" style="display: none;">
                            <ui:Label text="AI 难度" class="room-field-label" />
                            <ui:VisualElement class="room-segmented-row">
                                <ui:Button name="AiDifficultyBeginner" text="新手" class="room-segment" />
                                <ui:Button name="AiDifficultyStandard" text="标准" class="room-segment room-segment-right" />
                            </ui:VisualElement>
                            <ui:Label text="构筑来源" class="room-field-label room-field-label-spaced" />
                            <ui:VisualElement class="room-template-list">
                                <ui:Button name="AiTemplateAggressive" text="进攻构筑 | 高价值组合与主动压制" class="room-template-button" />
                                <ui:Button name="AiTemplateStable" text="稳健构筑 | 均衡牌库与容错天赋" class="room-template-button" />
                                <ui:Button name="AiTemplateSynergy" text="天赋联动 | 围绕事件和充能组织" class="room-template-button" />
                                <ui:Button name="AiTemplateCopySelf" text="复制本家 | 复制当前已保存卡组" class="room-template-button" />
                            </ui:VisualElement>
                            <ui:Label text="公开构筑摘要" class="room-field-label room-field-label-spaced" />
                            <ui:VisualElement class="room-loadout-summary">
                                <ui:Label name="AiDeckSummary" text="牌库：--" class="room-budget-line" />
                                <ui:Label name="AiTalentSummary" text="天赋：--" class="room-budget-line" />
                                <ui:Label name="AiBudgetSummary" text="总预算：--" class="room-budget-total" />
                            </ui:VisualElement>
                            <ui:Label text="构筑模板只改变牌库和天赋，不改变 AI 的难度策略。" class="room-info-note" />
                            <ui:VisualElement name="AiOverwriteConfirm" class="room-inline-confirm" style="display: none;">
                                <ui:Label text="当前草稿有未保存修改，切换来源会覆盖它。" class="room-inline-confirm-text" />
                                <ui:VisualElement class="room-inline-confirm-actions">
                                    <ui:Button name="AiOverwriteAccept" text="确认覆盖" class="room-small-button" />
                                    <ui:Button name="AiOverwriteCancel" text="保留草稿" class="room-small-button room-small-button-secondary" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="room-config-actions">
                                <ui:Button name="AiApplyButton" text="应用配置" class="room-config-button" />
                                <ui:Button name="AiAdvancedButton" text="高级编辑" class="room-config-button room-config-button-secondary" />
                                <ui:Button name="AiRemoveButton" text="移除 AI" class="room-config-button room-config-button-danger" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="RoomSeatReadOnly" class="room-read-only-detail">
                            <ui:Label name="RoomSeatReadOnlyText" text="选择永久 AI 可查看公开构筑；房主选择空席可添加 AI。" class="room-read-only-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="room-bottom-bar">
                    <ui:VisualElement class="room-notice-block">
                        <ui:Label name="RoomNoticeTitle" text="等待房间状态" class="room-notice-title" />
                        <ui:Label name="RoomNoticeCopy" text="所有房间状态均以服务器权威消息为准。" class="room-notice-copy" />
                    </ui:VisualElement>
                    <ui:Button name="RoomReadyButton" text="确认准备" class="room-footer-button" />
                    <ui:Button name="LeaveRoomButton" text="离开房间" class="room-footer-button room-leave-button-new" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Workshop View -->
            <ui:VisualElement name="ViewWorkshop" class="view-container" style="display: none;">
                <ui:Label text="Deck Workshop" class="view-title" />
                <ui:Label text="Select and build your custom mahjong deck." class="view-subtitle" />
                <!-- UI for Gacha/Cosmetic preview will go here in the future -->
                <ui:VisualElement name="DeckEditorContainer" />
            </ui:VisualElement>

            <!-- Compendium View -->
            <ui:VisualElement name="ViewCompendium" class="view-container" style="display: none;">
                <ui:VisualElement class="compendium-header">
                    <ui:Label text="玩法图鉴与规则速查" class="view-title" />
                    <ui:Label text="国标 81 番种速查检索、9 大天赋流派机制及 Roguelike 异化核心规则一览" class="view-subtitle" />
                </ui:VisualElement>

                <!-- Subtab Navigation Bar -->
                <ui:VisualElement class="compendium-subtab-bar">
                    <ui:Button name="SubtabBtnMcr" text="国标 81 番种速查" class="compendium-subtab-btn compendium-subtab-active" />
                    <ui:Button name="SubtabBtnTalent" text="天赋与流派图鉴" class="compendium-subtab-btn" />
                    <ui:Button name="SubtabBtnRules" text="核心机制与对战规则" class="compendium-subtab-btn" />
                </ui:VisualElement>

                <!-- Subview 1: MCR 81 Fan -->
                <ui:VisualElement name="CompendiumMcrView" class="compendium-subview">
                    <ui:VisualElement class="compendium-toolbar">
                        <ui:VisualElement class="compendium-filter-group">
                            <ui:Button name="FanFilterAll" text="全部 (81)" class="compendium-filter-btn compendium-filter-active" />
                            <ui:Button name="FanFilterTop" text="顶级大番 (48~88番)" class="compendium-filter-btn" />
                            <ui:Button name="FanFilterHigh" text="高番种 (16~32番)" class="compendium-filter-btn" />
                            <ui:Button name="FanFilterMid" text="中番种 (6~12番)" class="compendium-filter-btn" />
                            <ui:Button name="FanFilterLow" text="小番种 (1~4番)" class="compendium-filter-btn" />
                        </ui:VisualElement>
                        <ui:TextField name="FanSearchInput" label="搜索" placeholder-text="输入番种名称或描述..." class="compendium-search-field" />
                    </ui:VisualElement>
                    <ui:VisualElement class="compendium-stats-bar">
                        <ui:Label name="FanCountLabel" text="显示 81 个番种" class="compendium-stats-text" />
                        <ui:Label text="国标起胡门槛：8 番" class="compendium-stats-hint" />
                    </ui:VisualElement>
                    <ui:ScrollView name="FanCardScrollView" class="compendium-scroll-view" />
                </ui:VisualElement>

                <!-- Subview 2: Talent Compendium -->
                <ui:VisualElement name="CompendiumTalentView" class="compendium-subview" style="display: none;">
                    <ui:VisualElement class="compendium-toolbar">
                        <ui:VisualElement class="compendium-filter-group">
                            <ui:Button name="TalentFilterAll" text="全部天赋 (9)" class="compendium-filter-btn compendium-filter-active" />
                            <ui:Button name="TalentFilterMajor" text="大天赋 (Major)" class="compendium-filter-btn" />
                            <ui:Button name="TalentFilterMedium" text="中天赋 (Medium)" class="compendium-filter-btn" />
                            <ui:Button name="TalentFilterMinor" text="小天赋 (Minor)" class="compendium-filter-btn" />
                            <ui:Button name="TalentFilterActive" text="主动充能" class="compendium-filter-btn" />
                        </ui:VisualElement>
                        <ui:TextField name="TalentSearchInput" label="搜索" placeholder-text="输入天赋名称或效果..." class="compendium-search-field" />
                    </ui:VisualElement>
                    <ui:VisualElement class="compendium-stats-bar">
                        <ui:Label name="TalentCountLabel" text="显示 9 个天赋规则" class="compendium-stats-text" />
                        <ui:Label text="携带构筑：6 主槽 (1大+2中+3小) + 3 备选槽" class="compendium-stats-hint" />
                    </ui:VisualElement>
                    <ui:ScrollView name="TalentCardScrollView" class="compendium-scroll-view" />
                </ui:VisualElement>

                <!-- Subview 3: Core Mechanics & Rules -->
                <ui:VisualElement name="CompendiumRulesView" class="compendium-subview" style="display: none;">
                    <ui:ScrollView name="RulesScrollView" class="compendium-scroll-view">
                        <!-- 机制 1 -->
                        <ui:VisualElement name="SessionScoreRulesCard" class="compendium-mechanic-card">
                            <ui:VisualElement class="compendium-mechanic-header">
                                <ui:Label text="1" class="compendium-mechanic-badge" />
                                <ui:Label text="模式起始分与击飞终局" class="compendium-mechanic-title" />
                            </ui:VisualElement>
                            <ui:Label text="每位玩家按所选对局模式获得起始分；「初始资金」等比赛开始天赋在此基础上继续叠加：" class="compendium-mechanic-desc" />
                            <ui:VisualElement class="compendium-mechanic-box">
                                <ui:Label text="四种模式起始分：" class="compendium-box-title" />
                                <ui:Label text="• 单局 (Single)：50 分&#10;• 东风局 (East Only)：100 分&#10;• 半庄 (Half Game)：150 分&#10;• 全庄 (Full Game)：200 分" class="compendium-box-desc" />
                            </ui:VisualElement>
                            <ui:VisualElement class="compendium-mechanic-box">
                                <ui:Label text="击飞与完整局末结算：" class="compendium-box-title" />
                                <ui:Label text="• 判定顺序：基础计分 -&gt; 全部局末天赋 -&gt; 天赋事件 -&gt; 推进局数 -&gt; 终局判定。&#10;• 完整结算后，任一玩家最终分数 &lt;= 0，整场立即结束；实际负分不会截断为 0。&#10;• 局末返还若先将 0 或负分救回正数，则不会击飞；多人可以在同一局同时击飞。&#10;• 若同一局也完成全部预定局数，终局按正常打满记录，但耗尽玩家仍标记「击飞」。" class="compendium-box-desc" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- 机制 2 -->
                        <ui:VisualElement class="compendium-mechanic-card">
                            <ui:VisualElement class="compendium-mechanic-header">
                                <ui:Label text="2" class="compendium-mechanic-badge" />
                                <ui:Label text="牌库异化值与预算体系 (Alienation System)" class="compendium-mechanic-title" />
                            </ui:VisualElement>
                            <ui:Label text="玩家可使用自定义的 34 张牌库进行对战。标准牌库包含 34 种牌各 1 张，异化值为 0 点。&#10;• 加减牌成本：增加或减少某张牌的数量均会产生异化值（例如加到同种牌 4 张或删除某张牌）。&#10;• 天赋成本叠加：当前激活的主天赋异化成本与牌库异化成本合并计入「总异化值」。" class="compendium-mechanic-desc" />
                            <ui:VisualElement class="compendium-mechanic-box">
                                <ui:Label text="服务端入场档位限制：" class="compendium-box-title" />
                                <ui:Label text="• 低异化档 (Low): 预算上限 40 点，适合偏向传统国标的纯净体验。&#10;• 标准档 (Standard): 预算上限 80 点（推荐默认），兼顾策略自由度与战力平衡。&#10;• 高异化档 (High): 预算上限 120 点，支持强力天赋组合与极限牌库构筑。" class="compendium-box-desc" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- 机制 3 -->
                        <ui:VisualElement class="compendium-mechanic-card">
                            <ui:VisualElement class="compendium-mechanic-header">
                                <ui:Label text="3" class="compendium-mechanic-badge" />
                                <ui:Label text="国标算分与 8 番起胡门槛" class="compendium-mechanic-title" />
                            </ui:VisualElement>
                            <ui:Label text="游戏遵循国标麻将规则，胡牌必须满足基础番数达到 8 番（天赋如「快人一步」可降低门槛至 6 番）。&#10;• 算番最大化：系统采用多路径拆解算法，在所有合法的拆牌方案中选取番数最高的组合。&#10;• 番数逐项归因：最终番数拆分为「基础国标番 + 天赋门槛修正 + 天赋奖励加番 - 天赋惩罚扣番」。" class="compendium-mechanic-desc" />
                            <ui:VisualElement class="compendium-mechanic-box">
                                <ui:Label text="积分结算规则：" class="compendium-box-title" />
                                <ui:Label text="• 自摸胡牌：其余三家各支付 (8 + 最终番数) 点积分。&#10;• 点炮胡牌：放炮者支付 (8 + 最终番数) 点积分，另外两家各支付底分 8 点积分。&#10;• 流局结算：无人胡牌时不计分（若装配「厚积」天赋，流局时可额外获得 5 补偿分）。" class="compendium-box-desc" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <!-- 机制 4 -->
                        <ui:VisualElement class="compendium-mechanic-card">
                            <ui:VisualElement class="compendium-mechanic-header">
                                <ui:Label text="4" class="compendium-mechanic-badge" />
                                <ui:Label text="多局对战制与门风轮转" class="compendium-mechanic-title" />
                            </ui:VisualElement>
                            <ui:Label text="国标麻将无传统日麻的连庄概念，无论谁胡牌，每小局结束后东风位置均按顺时针轮转：&#10;• 单局 (Single)：1 局定胜负。&#10;• 东风局 (East Only)：共 4 小局，每位玩家各坐东家一次。&#10;• 半庄 (Half Game)：共 8 小局（东风圈 4 局 + 南风圈 4 局）。&#10;• 全庄 (Full Game)：共 16 小局（东南西北四圈各 4 局）。" class="compendium-mechanic-desc" />
                        </ui:VisualElement>

                        <!-- 机制 5 -->
                        <ui:VisualElement class="compendium-mechanic-card">
                            <ui:VisualElement class="compendium-mechanic-header">
                                <ui:Label text="5" class="compendium-mechanic-badge" />
                                <ui:Label text="中场备牌机制 (Sideboard Phase)" class="compendium-mechanic-title" />
                            </ui:VisualElement>
                            <ui:Label text="在多局对战（半庄或全庄）进行到第 4 小局结束时，比赛进入 45 秒的中场备牌阶段：&#10;• 玩家可根据前 4 局对手的打法风格与分数差距，从已携带的 6 主槽 + 3 备选槽中重新调配主槽天赋。&#10;• 备牌调整后总异化值不得超过房间预设档位，锁定后将在后半程比赛中持续生效。&#10;• 若第 4 小局完整结算后已有玩家被击飞，则整场先结束，不再进入备牌阶段。" class="compendium-mechanic-desc" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Collection View -->
            <ui:VisualElement name="ViewCollection" class="view-container" style="display: none;">
                <ui:Label text="Collection &amp; Shop" class="view-title" />
                <ui:Label text="Unlock cosmetics, gacha, and new tile skins. (Coming Soon)" class="view-subtitle" />
            </ui:VisualElement>

            <!-- Settings View -->
            <ui:VisualElement name="ViewSettings" class="view-container settings-view" style="display: none;">
                <ui:ScrollView name="SettingsScrollView" horizontal-scroller-visibility="Hidden" class="settings-scroll-view">
                    <ui:Label text="设置" class="view-title settings-page-title" />

                    <ui:VisualElement class="settings-section">
                        <ui:Label text="声音设置" class="settings-section-title" />
                        <ui:Instance template="SharedAudioSettings" />
                    </ui:VisualElement>

                    <ui:VisualElement class="settings-section connection-settings-section">
                        <ui:VisualElement class="connection-page-header">
                            <ui:Label text="连接设置" class="settings-section-title connection-title" />
                            <ui:Label name="ConnectionStatusPill" text="已断开" class="connection-status-pill connection-status-gray" />
                        </ui:VisualElement>
                        <ui:VisualElement class="connection-columns">
                            <ui:VisualElement class="connection-card connection-selection-card">
                                <ui:Label text="服务器选择" class="connection-card-title" />
                                <ui:Toggle name="LocalServerToggle" label="使用本地服务器" class="connection-toggle" />
                                <ui:Label name="ConnectionAddressLabel" text="当前地址：--" class="connection-address" />
                                <ui:Label text="仅在本次会话生效；重启客户端后恢复在线服务器。" class="connection-restart-hint" />
                                <ui:Button name="RetestConnectionButton" text="重新测试连接" class="connection-retest-button" />
                            </ui:VisualElement>
                            <ui:VisualElement class="connection-card connection-diagnostics-card">
                                <ui:Label text="连接诊断" class="connection-card-title" />
                                <ui:Label name="ConnectionSocketPhaseLabel" text="套接字阶段：--" class="connection-detail" />
                                <ui:Label name="ConnectionHandshakeLabel" text="v12 握手：--" class="connection-detail" />
                                <ui:Label name="ConnectionRttLabel" text="RTT：--" class="connection-detail" />
                                <ui:Label name="ConnectionLastCheckedLabel" text="上次检查：--" class="connection-detail" />
                                <ui:Label name="ConnectionErrorLabel" text="最近错误：--" class="connection-detail connection-error" />
                                <ui:Label name="ConnectionReadinessLabel" text="就绪状态：--" class="connection-readiness" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
