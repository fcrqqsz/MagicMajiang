/* 容器：右下角对齐 */
.action-panel-root {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: flex-end;
    padding-bottom: 100px;
    padding-right: 50px;
}

/* 按钮容器：横排 */
.button-row {
    flex-direction: row;
}

/* 基础按钮样式 */
.action-btn {
    width: 100px;
    height: 100px;
    margin: 10px;
    border-radius: 50px; /* 圆形按钮 */
    font-size: 36px;
    color: white;
    -unity-font-style: bold;
    border-width: 4px;
    border-color: rgba(255,255,255,0.5);
    transition-duration: 0.1s;
}

/* 鼠标悬停效果 */
.action-btn:hover {
    scale: 1.1;
}
.action-btn:active {
    scale: 0.95;
}

/* 各个按钮的颜色 */
.btn-chi { background-color: #4CAF50; } /* 绿 */
.btn-pon { background-color: #2196F3; } /* 蓝 */
.btn-gan { background-color: #FF9800; } /* 橙 */
.btn-hu  { background-color: #F44336; width: 120px; height: 120px; font-size: 48px; } /* 红，大一点 */
.btn-skip{ background-color: #9E9E9E; width: 80px; height: 80px; font-size: 24px; } /* 灰，小一点 */

/* 字体修正 (确保显示中文) */
.unity-text-element {
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}
