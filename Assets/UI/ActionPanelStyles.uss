.action-panel-root {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: flex-end;
    padding-bottom: 194px;
    padding-right: 28px;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.button-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: flex-end;
    max-width: 560px;
}

.talent-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 560px;
    min-height: 52px;
}

.talent-action-status {
    color: #FFD9B3;
    font-size: 17px;
    -unity-text-align: middle-right;
    margin-right: 6px;
}

.talent-action-btn {
    min-width: 112px;
    height: 48px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 3px;
    margin-bottom: 3px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 225, 145, 0.85);
    border-right-color: rgba(255, 225, 145, 0.85);
    border-top-color: rgba(255, 225, 145, 0.85);
    border-bottom-color: rgba(255, 225, 145, 0.85);
    background-color: rgba(52, 38, 82, 0.96);
    color: #FFF4CF;
    font-size: 19px;
    -unity-font-style: bold;
}

.talent-action-btn:hover {
    background-color: rgba(78, 55, 118, 0.98);
}

.talent-action-btn:disabled {
    opacity: 0.55;
}

.talent-choice-prompt {
    color: #FFF4CF;
    font-size: 17px;
    -unity-text-align: middle-center;
    margin-right: 10px;
}

.talent-choice-btn { min-width: 78px; }

.talent-choice-cancel-btn {
    min-width: 78px;
    border-left-color: rgba(205, 205, 215, 0.85);
    border-right-color: rgba(205, 205, 215, 0.85);
    border-top-color: rgba(205, 205, 215, 0.85);
    border-bottom-color: rgba(205, 205, 215, 0.85);
    background-color: rgba(58, 58, 70, 0.96);
}

.action-btn {
    width: 64px;
    height: 64px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-bottom-right-radius: 32px;
    font-size: 23px;
    color: white;
    -unity-font-style: bold;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255,255,255,0.5);
    border-right-color: rgba(255,255,255,0.5);
    border-top-color: rgba(255,255,255,0.5);
    border-bottom-color: rgba(255,255,255,0.5);
    transition-duration: 0.1s;
}

.action-btn:hover {
    scale: 1.06;
}
.action-btn:active {
    scale: 0.95;
}

/* 各个按钮的颜色 */
.btn-chi { background-color: #4CAF50; }
.btn-pon { background-color: #2196F3; }
.btn-ming-gang { background-color: #FF9800; }
.btn-an-gang { background-color: #9C27B0; }
.btn-jia-gang { background-color: #FF7043; }
.btn-hu { width: 72px; height: 72px; font-size: 30px; background-color: #F44336; }
.btn-skip { width: 56px; height: 56px; font-size: 19px; background-color: #9E9E9E; }
.chi-target-btn { width: 110px; height: 64px; background-color: #45964A; }
.kong-target-btn { width: 110px; height: 64px; background-color: #7E57C2; }
