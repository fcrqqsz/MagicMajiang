/* 容器：右下角对齐 */
.action-panel-root {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: flex-end;
    padding-bottom: 100px;
    padding-right: 50px;
}

/* 按钮容器：横排 */
.button-row {
    flex-direction: row;
}

.talent-action-row {
    flex-direction: row;
    justify-content: flex-end;
    min-height: 70px;
}

.talent-action-status {
    color: #FFD9B3;
    font-size: 22px;
    -unity-text-align: middle-right;
    margin-right: 12px;
}

.talent-action-btn {
    min-width: 150px;
    height: 62px;
    margin: 6px 10px;
    padding-left: 20px;
    padding-right: 20px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(255, 225, 145, 0.85);
    background-color: rgba(52, 38, 82, 0.96);
    color: #FFF4CF;
    font-size: 25px;
    -unity-font-style: bold;
}

.talent-action-btn:hover {
    background-color: rgba(78, 55, 118, 0.98);
}

.talent-action-btn:disabled {
    opacity: 0.55;
}

/* 基础按钮样式 */
.action-btn {
    width: 100px;
    height: 100px;
    margin: 10px;
    border-radius: 50px; /* 圆形按钮 */
    font-size: 36px;
    color: white;
    -unity-font-style: bold;
    border-width: 4px;
    border-color: rgba(255,255,255,0.5);
    transition-duration: 0.1s;
}

/* 鼠标悬停效果 */
.action-btn:hover {
    scale: 1.1;
}
.action-btn:active {
    scale: 0.95;
}

/* 各个按钮的颜色 */
.btn-chi { background-color: #4CAF50; } /* 绿 */
.btn-pon { background-color: #2196F3; } /* 蓝 */
.btn-ming-gang { background-color: #FF9800; } /* 橙 */
.btn-an-gang { background-color: #9C27B0; } /* 紫 */
.btn-jia-gang { background-color: #FF7043; } /* 深橙 */
.btn-hu  { background-color: #F44336; width: 120px; height: 120px; font-size: 48px; } /* 红，大一点 */
.btn-skip{ background-color: #9E9E9E; width: 80px; height: 80px; font-size: 24px; } /* 灰，小一点 */
.kong-target-btn { width: 140px; height: 100px; background-color: #7E57C2; }

/* 字体修正 (确保显示中文) */
.unity-text-element {
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}
