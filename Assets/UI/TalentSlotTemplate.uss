.talent-slot {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100px;
    height: 120px;
    margin: 4px;
    padding: 6px;
    border-width: 2px;
    border-color: #555;
    border-radius: 8px;
    background-color: rgba(30, 30, 40, 0.8);
}

.talent-slot:hover {
    border-color: #aaa;
    background-color: rgba(50, 50, 60, 0.9);
}

.talent-slot.occupied {
    border-color: #7a5af5;
}

.talent-slot.tier-large {
    border-color: #f5a623;
}

.talent-slot.tier-medium {
    border-color: #7a5af5;
}

.talent-slot.tier-small {
    border-color: #4a9af5;
}

.talent-slot-tier {
    font-size: 12px;
    color: #aaa;
    margin-bottom: 2px;
}

.talent-slot-name {
    font-size: 11px;
    color: #ccc;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 90px;
}

.talent-slot-clear {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 18px;
    height: 18px;
    font-size: 10px;
    padding: 0;
    margin: 0;
    border-radius: 9px;
    background-color: rgba(200, 50, 50, 0.7);
    color: white;
    display: none;
}

.talent-slot.occupied .talent-slot-clear {
    display: flex;
}
