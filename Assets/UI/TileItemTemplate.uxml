<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Root" class="tile-item">
        <ui:VisualElement name="FaceImage" class="tile-face-image" />
        
        <ui:VisualElement class="button-row">
            <ui:Button name="BtnMinus" text="-" class="action-btn" />
            <ui:Label name="CountLabel" text="0" class="tile-count" />
            <ui:Button name="BtnPlus" text="+" class="action-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>