<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="ResultPanelStyles.uss" />
    <ui:VisualElement name="Overlay" class="overlay">
        <ui:VisualElement name="Panel" class="result-panel">
            <ui:Label name="TitleLabel" text="荣  胡" class="title-text" />
            <ui:Label name="FinalFanHero" text="最终番 0" class="final-fan-hero" picking-mode="Ignore" />
            <ui:VisualElement name="FanBreakdown" class="fan-breakdown" picking-mode="Ignore">
                <ui:Label name="BaseFanRow" text="基础番 0" class="breakdown-row breakdown-row--base" picking-mode="Ignore" />
                <ui:ScrollView name="TalentContributionList" class="talent-contribution-list" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:ScrollView name="FanListContainer" class="fan-list" />
            <ui:VisualElement name="WinningHandSection" class="winning-hand-strip" picking-mode="Ignore">
                <ui:VisualElement name="WinningHandRow" class="winning-hand-row" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Button name="BtnRestart" text="再来一局" class="restart-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
