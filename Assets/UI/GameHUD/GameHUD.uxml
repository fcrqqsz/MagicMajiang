<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GameHUD/GameHUDStyles.uss" />
    <ui:VisualElement name="HUDRoot" class="hud-root" picking-mode="Ignore">

        <!-- 左上角信息栏 -->
        <ui:VisualElement name="InfoBar" class="info-bar" picking-mode="Ignore">
            <ui:Label name="InfoLabel" text="单局-余136张" class="info-label" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- 事件流：侧边轻量历史，最多四条 -->
        <ui:VisualElement name="TalentEffectFeed" class="talent-effect-feed" picking-mode="Ignore" />
        <ui:Button name="TalentDrawerDismissLayer" class="talent-drawer-dismiss" />

        <!-- 本家分层栏：位于手牌安全区上方 -->
        <ui:VisualElement name="OwnTalentLayer" class="own-talent-layer">
            <ui:VisualElement name="OwnTalentBar" class="own-talent-bar" picking-mode="Ignore" />
            <ui:Button name="OwnTalentCollapsedButton" text="" class="talent-more-button" />
            <ui:VisualElement name="OwnTalentDrawer" class="talent-drawer talent-drawer--bottom" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- 四席已知天赋：本席容器保留统一映射，对手摘要固定最多两项 -->
        <ui:VisualElement name="Seat0TalentLayer" class="seat-talent-layer seat-talent-layer--bottom">
            <ui:VisualElement name="Seat0KnownTalents" class="known-talent-row" picking-mode="Ignore" />
            <ui:Button name="Seat0KnownTalentMore" text="" class="talent-more-button" />
            <ui:VisualElement name="Seat0KnownTalentDrawer" class="talent-drawer talent-drawer--bottom" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="Seat1TalentLayer" class="seat-talent-layer seat-talent-layer--right">
            <ui:VisualElement name="Seat1KnownTalents" class="known-talent-row known-talent-row--vertical" picking-mode="Ignore" />
            <ui:Button name="Seat1KnownTalentMore" text="" class="talent-more-button" />
            <ui:VisualElement name="Seat1KnownTalentDrawer" class="talent-drawer talent-drawer--right" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="Seat2TalentLayer" class="seat-talent-layer seat-talent-layer--top">
            <ui:VisualElement name="Seat2KnownTalents" class="known-talent-row" picking-mode="Ignore" />
            <ui:Button name="Seat2KnownTalentMore" text="" class="talent-more-button" />
            <ui:VisualElement name="Seat2KnownTalentDrawer" class="talent-drawer talent-drawer--top" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="Seat3TalentLayer" class="seat-talent-layer seat-talent-layer--left">
            <ui:VisualElement name="Seat3KnownTalents" class="known-talent-row known-talent-row--vertical" picking-mode="Ignore" />
            <ui:Button name="Seat3KnownTalentMore" text="" class="talent-more-button" />
            <ui:VisualElement name="Seat3KnownTalentDrawer" class="talent-drawer talent-drawer--left" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- 中央菱形 -->
        <ui:VisualElement name="DiamondWrapper" class="diamond-wrapper" picking-mode="Ignore">
            <ui:VisualElement name="Diamond" class="diamond" picking-mode="Ignore">

                <!-- 上方座位 (对家 index=2) -->
                <ui:VisualElement name="SeatTop" class="seat seat-top" picking-mode="Ignore">
                    <ui:VisualElement name="GlowTop" class="glow" picking-mode="Ignore" />
                    <ui:Label name="WindTop" text="北" class="wind-label" picking-mode="Ignore" />
                    <ui:Label name="ScoreTop" text="0" class="score-label" picking-mode="Ignore" />
                </ui:VisualElement>

                <!-- 左侧座位 (上家 index=3) -->
                <ui:VisualElement name="SeatLeft" class="seat seat-left" picking-mode="Ignore">
                    <ui:VisualElement name="GlowLeft" class="glow" picking-mode="Ignore" />
                    <ui:Label name="WindLeft" text="西" class="wind-label" picking-mode="Ignore" />
                    <ui:Label name="ScoreLeft" text="0" class="score-label" picking-mode="Ignore" />
                </ui:VisualElement>

                <!-- 中心倒计时 -->
                <ui:VisualElement name="TimerCenter" class="timer-center" picking-mode="Ignore">
                    <ui:VisualElement name="ArcTop" class="arc-segment arc-top" picking-mode="Ignore" />
                    <ui:VisualElement name="ArcRight" class="arc-segment arc-right" picking-mode="Ignore" />
                    <ui:VisualElement name="ArcBottom" class="arc-segment arc-bottom" picking-mode="Ignore" />
                    <ui:VisualElement name="ArcLeft" class="arc-segment arc-left" picking-mode="Ignore" />
                    <ui:VisualElement name="TimerInner" class="timer-inner" picking-mode="Ignore">
                        <ui:Label name="TimerText" text="30" class="timer-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 右侧座位 (下家 index=1) -->
                <ui:VisualElement name="SeatRight" class="seat seat-right" picking-mode="Ignore">
                    <ui:VisualElement name="GlowRight" class="glow" picking-mode="Ignore" />
                    <ui:Label name="WindRight" text="东" class="wind-label" picking-mode="Ignore" />
                    <ui:Label name="ScoreRight" text="0" class="score-label" picking-mode="Ignore" />
                </ui:VisualElement>

                <!-- 下方座位 (自己 index=0) -->
                <ui:VisualElement name="SeatBottom" class="seat seat-bottom" picking-mode="Ignore">
                    <ui:VisualElement name="GlowBottom" class="glow" picking-mode="Ignore" />
                    <ui:Label name="WindBottom" text="南" class="wind-label" picking-mode="Ignore" />
                    <ui:Label name="ScoreBottom" text="0" class="score-label" picking-mode="Ignore" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 中央安全区强反馈，不接收输入 -->
        <ui:Label name="TalentToast" text="" class="talent-toast" picking-mode="Ignore" />

    </ui:VisualElement>
</ui:UXML>
