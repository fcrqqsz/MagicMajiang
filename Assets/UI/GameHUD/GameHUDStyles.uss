/* ======= HUD Root: 全屏透传容器 ======= */
.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

/* ======= 分层天赋 HUD（B 密度） ======= */
.own-talent-layer {
    position: absolute;
    left: 50%;
    bottom: 188px;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
}

.own-talent-bar,
.known-talent-row {
    flex-direction: row;
    align-items: center;
}

.seat-talent-layer {
    position: absolute;
    align-items: center;
}

.seat-talent-layer--bottom {
    left: 50%;
    top: 58%;
    translate: -50% 0;
    display: none;
}

.seat-talent-layer--right {
    right: 28px;
    top: 50%;
    translate: 0 -50%;
}

.seat-talent-layer--top {
    left: 50%;
    top: 30px;
    translate: -50% 0;
}

.seat-talent-layer--left {
    left: 28px;
    top: 50%;
    translate: 0 -50%;
}

.known-talent-row--vertical {
    flex-direction: column;
}

.talent-more-button {
    min-width: 42px;
    height: 28px;
    margin: 2px;
    padding: 2px 7px;
    border-width: 1px;
    border-color: rgba(203, 178, 109, 0.64);
    border-radius: 7px;
    background-color: rgba(8, 20, 14, 0.9);
    color: #E8E1CB;
    font-size: 14px;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.talent-drawer {
    position: absolute;
    display: none;
    max-width: 420px;
    padding: 8px;
    flex-direction: row;
    flex-wrap: wrap;
    background-color: rgba(5, 15, 10, 0.96);
    border-width: 1px;
    border-color: rgba(212, 175, 55, 0.7);
    border-radius: 9px;
}

.talent-drawer--visible {
    display: flex;
}

.talent-drawer--bottom { bottom: 36px; left: 50%; translate: -50% 0; }
.talent-drawer--top { top: 36px; left: 50%; translate: -50% 0; }
.talent-drawer--right { right: 46px; top: 50%; translate: 0 -50%; }
.talent-drawer--left { left: 46px; top: 50%; translate: 0 -50%; }

.talent-effect-feed {
    position: absolute;
    right: 26px;
    top: 84px;
    width: 260px;
    align-items: flex-end;
}

.talent-drawer-dismiss {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.talent-drawer-dismiss--visible { display: flex; }

.talent-feed-row {
    margin-bottom: 4px;
    padding: 5px 10px;
    background-color: rgba(5, 18, 12, 0.78);
    border-radius: 6px;
    color: #D9D3C2;
    font-size: 14px;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.talent-feed-row--positive { color: #91E0A6; }
.talent-feed-row--negative { color: #EEA0A0; }

.talent-toast {
    position: absolute;
    left: 50%;
    top: 40%;
    translate: -50% -50%;
    display: none;
    padding: 12px 24px;
    background-color: rgba(4, 20, 12, 0.94);
    border-width: 2px;
    border-color: #E5C66E;
    border-radius: 10px;
    color: #FFF1B0;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.talent-toast--visible { display: flex; }

/* ======= 左上角信息栏 ======= */
.info-bar {
    position: absolute;
    left: 30px;
    top: 30px;
    background-color: rgba(0, 10, 5, 0.8);
    border-width: 2px;
    border-color: #D4AF37;
    border-radius: 8px;
    padding: 8px 16px;
}

.info-label {
    font-size: 22px;
    color: #E0D8C0;
    -unity-font-style: bold;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

/* ======= 中央菱形容器 ======= */
.diamond-wrapper {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 200px;
    height: 200px;
}

.diamond {
    width: 100%;
    height: 100%;
    rotate: 45deg;
    background-color: rgba(0, 20, 10, 0.75);
    border-width: 2px;
    border-color: #D4AF37;
    border-radius: 6px;
}

/* ======= 座位通用 ======= */
.seat {
    position: absolute;
    rotate: -45deg;
    align-items: center;
    justify-content: center;
}

/* 上方 (对家) — 未旋转正方形的左上角 → 旋转后为菱形顶点 */
.seat-top {
    top: 8px;
    left: 8px;
}

/* 下方 (自己) — 未旋转正方形的右下角 → 旋转后为菱形底点 */
.seat-bottom {
    bottom: 8px;
    right: 8px;
}

/* 左侧 (上家) — 未旋转正方形的左下角 → 旋转后为菱形左点 */
.seat-left {
    bottom: 8px;
    left: 8px;
}

/* 右侧 (下家) — 未旋转正方形的右上角 → 旋转后为菱形右点 */
.seat-right {
    top: 8px;
    right: 8px;
}

/* ======= 风位标签 ======= */
.wind-label {
    font-size: 24px;
    -unity-font-style: bold;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
    color: rgba(120, 120, 120, 0.4);
    -unity-text-align: middle-center;
}

.wind-label--active {
    color: #FFD700;
}

.wind-label--inactive {
    color: rgba(120, 120, 120, 0.4);
}

/* ======= 分数标签 ======= */
.score-label {
    font-size: 25px;
    color: #C0C0C0;
    -unity-text-align: middle-center;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.score-label--active {
    color: #FFFFFF;
}

/* ======= 发光效果元素 (叠加在活跃风字后面) ======= */
.glow {
    position: absolute;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgba(255, 215, 0, 0.25);
    translate: -50% -50%;
    left: 50%;
    top: 50%;
    display: none;
}

.glow--visible {
    display: flex;
}

/* ======= 中心计时器 ======= */
.timer-center {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    rotate: -45deg;
    width: 70px;
    height: 70px;
    align-items: center;
    justify-content: center;
}

/* 进度条段 - 四条矩形围绕中心 */
.arc-segment {
    position: absolute;
    background-color: #4CAF50;
    border-radius: 2px;
}

/* 上方进度条 */
.arc-top {
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: 50px;
    height: 5px;
    transform-origin: center center;
}

/* 下方进度条 */
.arc-bottom {
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    width: 50px;
    height: 5px;
    transform-origin: center center;
}

/* 左侧进度条 */
.arc-left {
    left: 0;
    top: 50%;
    translate: 0 -50%;
    width: 5px;
    height: 50px;
    transform-origin: center center;
}

/* 右侧进度条 */
.arc-right {
    right: 0;
    top: 50%;
    translate: 0 -50%;
    width: 5px;
    height: 50px;
    transform-origin: center center;
}

/* 中心圆形内圈 */
.timer-inner {
    width: 46px;
    height: 46px;
    border-radius: 23px;
    background-color: rgba(0, 0, 0, 0.85);
    border-width: 1px;
    border-color: rgba(212, 175, 55, 0.5);
    align-items: center;
    justify-content: center;
}

.timer-text {
    font-size: 22px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}
