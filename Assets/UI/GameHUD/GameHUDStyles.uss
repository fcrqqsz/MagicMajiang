/* ======= HUD Root: 全屏透传容器 ======= */
.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

/* ======= 分层天赋 HUD（B 密度） ======= */
.own-talent-layer {
    position: absolute;
    left: 24px;
    bottom: 20px;
    flex-direction: row;
    align-items: center;
}

.own-talent-bar,
.known-talent-row {
    flex-direction: row;
    align-items: center;
}

.seat-talent-layer {
    position: absolute;
    align-items: center;
}

.seat-talent-layer--bottom {
    left: 50%;
    top: 58%;
    translate: -50% 0;
    display: none;
}

.seat-talent-layer--right {
    right: 20px;
    top: 50%;
    translate: 0 -50%;
}

.seat-talent-layer--top {
    left: 50%;
    top: 20px;
    translate: -50% 0;
}

.seat-talent-layer--left {
    left: 20px;
    top: 50%;
    translate: 0 -50%;
}

.known-talent-row--vertical {
    flex-direction: column;
}

.talent-player-name {
    display: none;
    max-width: 160px;
    margin-bottom: 3px;
    padding-left: 7px;
    padding-right: 7px;
    color: #E8E1CB;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.talent-more-button {
    min-width: 42px;
    height: 28px;
    margin: 2px;
    padding: 2px 7px;
    border-width: 1px;
    border-color: rgba(203, 178, 109, 0.64);
    border-radius: 7px;
    background-color: rgba(8, 20, 14, 0.9);
    color: #E8E1CB;
    font-size: 14px;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.talent-drawer {
    position: absolute;
    display: none;
    max-width: 420px;
    padding: 8px;
    flex-direction: row;
    flex-wrap: wrap;
    background-color: rgba(5, 15, 10, 0.96);
    border-width: 1px;
    border-color: rgba(212, 175, 55, 0.7);
    border-radius: 9px;
}

.talent-drawer--visible {
    display: flex;
}

.talent-drawer--bottom { bottom: 36px; left: 0; }
.talent-drawer--top { top: 36px; left: 50%; translate: -50% 0; }
.talent-drawer--right { right: 46px; top: 50%; translate: 0 -50%; }
.talent-drawer--left { left: 46px; top: 50%; translate: 0 -50%; }

.talent-effect-feed {
    position: absolute;
    right: 20px;
    top: 68px;
    width: 240px;
    max-height: 116px;
    overflow: hidden;
    align-items: flex-end;
}

.talent-drawer-dismiss {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.talent-drawer-dismiss--visible { display: flex; }

.talent-feed-row {
    margin-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    background-color: rgba(5, 18, 12, 0.78);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    color: #D9D3C2;
    font-size: 13px;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.talent-feed-row--positive { color: #91E0A6; }
.talent-feed-row--negative { color: #EEA0A0; }

.talent-toast {
    position: absolute;
    left: 50%;
    top: 42%;
    translate: -50% -50%;
    display: none;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: rgba(4, 20, 12, 0.94);
    border-width: 2px;
    border-color: #E5C66E;
    border-radius: 10px;
    color: #FFF1B0;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.talent-toast--visible { display: flex; }

/* ======= 左上角信息栏 ======= */
.info-bar {
    position: absolute;
    left: 22px;
    top: 20px;
    background-color: rgba(0, 10, 5, 0.8);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: #D4AF37;
    border-right-color: #D4AF37;
    border-top-color: #D4AF37;
    border-bottom-color: #D4AF37;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.info-label {
    font-size: 18px;
    color: #E0D8C0;
    -unity-font-style: bold;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

/* ======= 中央指挥盘 ======= */
.diamond-wrapper {
    position: absolute;
    left: 50%;
    top: 45.4%;
    translate: -50% -50%;
    width: 164px;
    height: 104px;
}

.diamond {
    width: 100%;
    height: 100%;
    background-color: rgba(2, 18, 15, 0.94);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(232, 196, 101, 0.94);
    border-right-color: rgba(232, 196, 101, 0.94);
    border-top-color: rgba(232, 196, 101, 0.94);
    border-bottom-color: rgba(232, 196, 101, 0.94);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

/* ======= 座位通用 ======= */
.seat {
    position: absolute;
    min-width: 56px;
    height: 26px;
    padding-left: 4px;
    padding-right: 4px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 48, 39, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(181, 154, 89, 0.48);
    border-right-color: rgba(181, 154, 89, 0.48);
    border-top-color: rgba(181, 154, 89, 0.48);
    border-bottom-color: rgba(181, 154, 89, 0.48);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.seat-top {
    top: 4px;
    left: 50%;
    translate: -50% 0;
}

.seat-bottom {
    bottom: 4px;
    left: 50%;
    translate: -50% 0;
}

.seat-left {
    left: 4px;
    top: 50%;
    translate: 0 -50%;
}

.seat-right {
    right: 4px;
    top: 50%;
    translate: 0 -50%;
}

/* ======= 风位标签 ======= */
.wind-label {
    margin-right: 3px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
    color: rgba(239, 236, 221, 0.92);
    -unity-text-align: middle-center;
}

.wind-label--active {
    color: #FFD700;
}

.wind-label--inactive {
    color: rgba(214, 216, 205, 0.78);
}

/* ======= 分数标签 ======= */
.score-label {
    font-size: 12px;
    color: #F0E8D2;
    -unity-text-align: middle-center;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.score-label--active {
    color: #FFFFFF;
}

/* ======= 发光效果元素 (叠加在活跃风字后面) ======= */
.glow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(255, 210, 82, 0.32);
    display: none;
}

.glow--visible {
    display: flex;
}

/* ======= 中心计时器 ======= */
.timer-center {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
}

/* 进度条段 - 四条矩形围绕中心 */
.arc-segment {
    position: absolute;
    background-color: #4CAF50;
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
}

/* 上方进度条 */
.arc-top {
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: 32px;
    height: 3px;
    transform-origin: center center;
}

/* 下方进度条 */
.arc-bottom {
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    width: 32px;
    height: 3px;
    transform-origin: center center;
}

/* 左侧进度条 */
.arc-left {
    left: 0;
    top: 50%;
    translate: 0 -50%;
    width: 3px;
    height: 32px;
    transform-origin: center center;
}

/* 右侧进度条 */
.arc-right {
    right: 0;
    top: 50%;
    translate: 0 -50%;
    width: 3px;
    height: 32px;
    transform-origin: center center;
}

/* 中心圆形内圈 */
.timer-inner {
    width: 34px;
    height: 34px;
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
    background-color: rgba(0, 0, 0, 0.92);
    border-width: 2px;
    border-color: rgba(232, 196, 101, 0.72);
    align-items: center;
    justify-content: center;
}

.timer-text {
    font-size: 17px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}
