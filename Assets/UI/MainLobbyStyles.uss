.lobby-root {
    flex-grow: 1;
    flex-direction: row;
    background-color: rgb(30, 30, 30);
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.sidebar {
    width: 250px;
    background-color: rgb(20, 20, 20);
    padding: 20px;
}

.sidebar-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
    margin-bottom: 30px;
}

.nav-button {
    padding: 12px;
    font-size: 16px;
    background-color: transparent;
    color: rgb(180, 180, 180);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    -unity-text-align: middle-left;
}

.nav-button:hover {
    background-color: rgb(40, 40, 40);
    color: white;
}

.nav-button.active-tab {
    background-color: rgb(60, 60, 60);
    color: white;
    -unity-font-style: bold;
}

.content-area {
    flex-grow: 1;
    padding: 40px;
    height: 100%;
    min-height: 0;
    overflow: hidden;
}

.view-container {
    flex-grow: 1;
    height: 100%;
    min-height: 0;
}

.view-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 10px;
}

.view-subtitle {
    font-size: 18px;
    color: rgb(180, 180, 180);
    margin-bottom: 30px;
}

.action-button {
    padding: 15px 30px;
    font-size: 24px;
    -unity-font-style: bold;
    background-color: rgb(200, 100, 50);
    color: white;
    border-radius: 8px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    align-self: flex-start;
}

.action-button:hover {
    background-color: rgb(220, 120, 70);
}

.action-button:active {
    background-color: rgb(180, 80, 30);
}

.home-action-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.room-browser-button {
    background-color: rgb(44, 94, 156);
    margin-left: 16px;
}

.room-browser-button:hover {
    background-color: rgb(58, 114, 184);
}

.room-browser-button:active {
    background-color: rgb(34, 76, 128);
}

.deck-selector {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
}

.deck-arrow-btn {
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 24px;
    color: rgb(180, 180, 180);
    padding: 8px 12px;
    border-radius: 4px;
}

.deck-arrow-btn:hover {
    color: white;
    background-color: rgb(60, 60, 60);
}

.deck-arrow-btn:disabled {
    opacity: 0.3;
}

.deck-name-display {
    flex-grow: 1;
    -unity-text-align: middle-center;
    margin-bottom: 0;
}

.room-preset-selector {
    margin-top: -14px;
    margin-bottom: 18px;
}

.room-admission-blocker {
    max-width: 620px;
    margin-bottom: 14px;
    padding: 10px 14px;
    background-color: rgb(82, 39, 43);
    border-left-width: 3px;
    border-left-color: rgb(255, 107, 107);
    border-radius: 5px;
}

.room-admission-blocker-label {
    color: rgb(255, 205, 205);
    font-size: 15px;
    white-space: normal;
}

.room-controls {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 20px;
    margin-bottom: 14px;
}

.room-id-input {
    width: 360px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 16px;
}

.room-id-input .unity-base-field__label {
    color: rgb(225, 225, 225);
    font-size: 16px;
    min-width: 155px;
    margin-right: 10px;
}

.room-id-input .unity-base-text-field__input {
    min-height: 36px;
    padding-left: 10px;
    padding-right: 10px;
    color: white;
    background-color: rgb(18, 18, 18);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(125, 145, 170);
    border-right-color: rgb(125, 145, 170);
    border-bottom-color: rgb(125, 145, 170);
    border-left-color: rgb(125, 145, 170);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.room-id-input .unity-base-text-field__input:focus {
    border-top-color: rgb(90, 170, 240);
    border-right-color: rgb(90, 170, 240);
    border-bottom-color: rgb(90, 170, 240);
    border-left-color: rgb(90, 170, 240);
}

.room-secondary-button {
    min-width: 140px;
    min-height: 38px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 8px 16px;
    background-color: rgb(55, 95, 145);
    color: white;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 5px;
    font-size: 16px;
}

.room-ready-button {
    min-width: 300px;
    min-height: 48px;
    padding: 10px 22px;
    margin-bottom: 14px;
    background-color: rgb(55, 145, 90);
    color: white;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 6px;
    font-size: 20px;
    -unity-font-style: bold;
    align-self: flex-start;
}

.room-ready-button:disabled {
    opacity: 0.45;
}

.room-view {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
}

.room-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 85, 104);
}

.room-title {
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
}

.room-state-label {
    color: rgb(132, 211, 255);
    font-size: 17px;
    -unity-font-style: bold;
}

.room-main-content {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    padding-top: 24px;
    padding-bottom: 18px;
}

.room-seat-section {
    flex-grow: 1;
    min-width: 420px;
    margin-right: 28px;
}

.room-summary-section {
    width: 300px;
    flex-shrink: 0;
    padding-left: 22px;
    border-left-width: 1px;
    border-left-color: rgb(66, 80, 98);
}

.room-section-title {
    color: rgb(230, 237, 246);
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.room-seat-list {
    flex-grow: 1;
    min-height: 264px;
    justify-content: space-between;
}

.room-seat-row {
    height: 58px;
    min-height: 58px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 8px;
    background-color: rgb(37, 43, 52);
    border-left-width: 3px;
    border-left-color: rgb(76, 89, 105);
    border-radius: 6px;
}

.room-seat-row-local {
    background-color: rgb(37, 62, 72);
    border-left-color: rgb(92, 205, 221);
}

.room-seat-number {
    width: 72px;
    color: rgb(156, 170, 188);
    font-size: 15px;
}

.room-seat-name {
    flex-grow: 1;
    min-width: 120px;
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
}

.room-seat-kind {
    width: 66px;
    color: rgb(185, 202, 220);
    -unity-text-align: middle-center;
}

.room-seat-ready {
    width: 86px;
    color: rgb(123, 219, 157);
    -unity-text-align: middle-right;
}

.room-detail-label {
    color: rgb(190, 204, 220);
    font-size: 16px;
    margin-bottom: 10px;
    white-space: normal;
}

.room-summary-divider {
    height: 1px;
    margin-top: 8px;
    margin-bottom: 18px;
    background-color: rgb(66, 80, 98);
}

.room-local-build-title {
    margin-top: 0;
}

.room-alienation-label {
    color: rgb(242, 192, 111);
}

.room-lock-label {
    margin-top: 8px;
    color: rgb(123, 219, 157);
    font-size: 15px;
    -unity-font-style: bold;
}

.room-footer {
    min-height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgb(70, 85, 104);
}

.room-waiting-label {
    flex-grow: 1;
    color: rgb(181, 196, 215);
    font-size: 16px;
    white-space: normal;
}

.room-actions {
    flex-direction: row;
    align-items: center;
}

.room-leave-button,
.room-confirm-ready-button {
    min-width: 138px;
    min-height: 40px;
    margin-left: 12px;
    padding: 8px 16px;
    color: white;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 6px;
    font-size: 16px;
    -unity-font-style: bold;
}

.room-leave-button {
    background-color: rgb(118, 67, 69);
}

.room-confirm-ready-button {
    background-color: rgb(55, 145, 90);
}

.room-confirm-ready-button:disabled {
    opacity: 0.45;
}

/* ========================================================
   Compendium (图鉴与规则速查) 样式
   ======================================================== */

.compendium-header {
    flex-shrink: 0;
    margin-bottom: 12px;
}

.compendium-header .view-title {
    margin-bottom: 4px;
}

.compendium-header .view-subtitle {
    margin-bottom: 0;
}

.compendium-subtab-bar {
    flex-shrink: 0;
    flex-direction: row;
    background-color: rgb(18, 20, 24);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
    margin-bottom: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(42, 48, 60);
    border-right-color: rgb(42, 48, 60);
    border-bottom-color: rgb(42, 48, 60);
    border-left-color: rgb(42, 48, 60);
}

.compendium-subtab-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 15px;
    color: rgb(160, 170, 185);
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    -unity-font-style: bold;
}

.compendium-subtab-btn:hover {
    color: white;
    background-color: rgb(32, 38, 50);
}

.compendium-subtab-btn.compendium-subtab-active {
    color: white;
    background-color: rgb(44, 94, 156);
}

.compendium-subview {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.compendium-toolbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(40, 46, 58);
}

.compendium-filter-group {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.compendium-filter-btn {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 13px;
    background-color: rgb(35, 40, 50);
    color: rgb(180, 190, 205);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(55, 62, 78);
    border-right-color: rgb(55, 62, 78);
    border-bottom-color: rgb(55, 62, 78);
    border-left-color: rgb(55, 62, 78);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-right: 6px;
    margin-bottom: 4px;
}

.compendium-filter-btn:hover {
    background-color: rgb(48, 56, 72);
    color: white;
}

.compendium-filter-btn.compendium-filter-active {
    background-color: rgb(92, 205, 221);
    color: rgb(15, 25, 35);
    border-top-color: rgb(92, 205, 221);
    border-right-color: rgb(92, 205, 221);
    border-bottom-color: rgb(92, 205, 221);
    border-left-color: rgb(92, 205, 221);
    -unity-font-style: bold;
}

.compendium-search-field {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
    height: 34px;
}

.compendium-search-field .unity-base-field__label {
    min-width: 0;
    width: auto;
    font-size: 13px;
    color: rgb(170, 185, 205);
    -unity-font-style: bold;
    margin-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.compendium-search-field .unity-base-text-field__input {
    width: 220px;
    height: 34px;
    background-color: rgb(18, 20, 24);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(55, 65, 80);
    border-right-color: rgb(55, 65, 80);
    border-bottom-color: rgb(55, 65, 80);
    border-left-color: rgb(55, 65, 80);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 10px;
    padding-right: 10px;
    color: white;
    font-size: 13px;
}

/* 鼠标悬停微高亮 */
.compendium-search-field .unity-base-text-field__input:hover {
    border-top-color: rgb(85, 100, 125);
    border-right-color: rgb(85, 100, 125);
    border-bottom-color: rgb(85, 100, 125);
    border-left-color: rgb(85, 100, 125);
    background-color: rgb(24, 28, 36);
}

/* 获得焦点待输入时的高亮提示（霓虹青边框 + 提亮背景色 + 边框加粗视觉） */
.compendium-search-field .unity-base-text-field__input:focus {
    background-color: rgb(26, 36, 50);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(92, 205, 221);
    border-right-color: rgb(92, 205, 221);
    border-bottom-color: rgb(92, 205, 221);
    border-left-color: rgb(92, 205, 221);
}

/* 焦点激活状态时标签联动高亮 */
.compendium-search-field.compendium-search-focused .unity-base-field__label {
    color: rgb(92, 205, 221);
}

.compendium-stats-bar {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    padding-left: 2px;
    padding-right: 2px;
}

.compendium-stats-text {
    font-size: 13px;
    color: rgb(140, 150, 165);
}

.compendium-stats-hint {
    font-size: 13px;
    color: rgb(242, 192, 111);
    -unity-font-style: bold;
}

.compendium-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-right: 6px;
}

/* 番种/天赋卡片通用样式 */
.compendium-card {
    flex-direction: column;
    background-color: rgb(32, 36, 46);
    border-left-width: 4px;
    border-left-color: rgb(70, 80, 100);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(45, 50, 62);
    border-right-color: rgb(45, 50, 62);
    border-bottom-color: rgb(45, 50, 62);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    margin-bottom: 10px;
}

.compendium-card:hover {
    background-color: rgb(38, 44, 56);
    border-left-color: rgb(92, 205, 221);
}

.compendium-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.compendium-card-title-group {
    flex-direction: row;
    align-items: center;
}

.compendium-card-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: white;
    margin-right: 10px;
}

.compendium-card-badge {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(180, 110, 40);
}

.badge-fan-top { background-color: rgb(215, 60, 60); }
.badge-fan-high { background-color: rgb(190, 110, 40); }
.badge-fan-mid { background-color: rgb(45, 110, 160); }
.badge-fan-low { background-color: rgb(80, 85, 105); }

.badge-tier-major { background-color: rgb(215, 60, 60); }
.badge-tier-medium { background-color: rgb(190, 110, 40); }
.badge-tier-minor { background-color: rgb(45, 110, 160); }

.compendium-card-meta-right {
    flex-direction: row;
    align-items: center;
}

.compendium-meta-tag {
    font-size: 12px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: rgb(22, 25, 32);
    color: rgb(160, 175, 195);
    margin-left: 8px;
}

.compendium-meta-tag-active {
    color: rgb(242, 192, 111);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(160, 120, 50);
    border-right-color: rgb(160, 120, 50);
    border-bottom-color: rgb(160, 120, 50);
    border-left-color: rgb(160, 120, 50);
}

.compendium-card-desc {
    font-size: 14px;
    color: rgb(200, 205, 215);
    white-space: normal;
    margin-bottom: 4px;
}

.compendium-card-extra {
    flex-direction: row;
    align-items: center;
    font-size: 13px;
    color: rgb(230, 140, 140);
    background-color: rgb(42, 28, 30);
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-top: 4px;
    white-space: normal;
}

.compendium-card-extra-talent {
    color: rgb(160, 205, 235);
    background-color: rgb(25, 38, 48);
}

/* 核心机制卡片 */
.compendium-mechanic-card {
    flex-direction: column;
    background-color: rgb(30, 34, 44);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 20px;
    padding-right: 20px;
    margin-bottom: 16px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(45, 52, 66);
    border-right-color: rgb(45, 52, 66);
    border-bottom-color: rgb(45, 52, 66);
    border-left-color: rgb(45, 52, 66);
}

.compendium-mechanic-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 52, 66);
}

.compendium-mechanic-badge {
    width: 24px;
    height: 24px;
    background-color: rgb(44, 94, 156);
    color: white;
    -unity-font-style: bold;
    font-size: 13px;
    -unity-text-align: middle-center;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    margin-right: 10px;
}

.compendium-mechanic-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
}

.compendium-mechanic-desc {
    font-size: 14px;
    color: rgb(195, 205, 220);
    white-space: normal;
    margin-bottom: 10px;
}

.compendium-mechanic-box {
    flex-direction: column;
    background-color: rgb(22, 26, 34);
    border-left-width: 3px;
    border-left-color: rgb(242, 192, 111);
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.compendium-box-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(242, 192, 111);
    margin-bottom: 4px;
}

.compendium-box-desc {
    font-size: 13px;
    color: rgb(180, 190, 205);
    white-space: normal;
}

/* Connection settings */
.settings-view {
    flex-direction: column;
}

.settings-scroll-view {
    flex-grow: 1;
    min-height: 0;
}

.settings-page-title {
    margin-bottom: 22px;
}

.settings-section {
    flex-direction: column;
    margin-bottom: 28px;
}

.settings-section-title {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.audio-settings-card {
    flex-direction: column;
    background-color: rgb(30, 35, 45);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(58, 68, 84);
    border-right-color: rgb(58, 68, 84);
    border-bottom-color: rgb(58, 68, 84);
    border-left-color: rgb(58, 68, 84);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 18px;
    padding-right: 22px;
    padding-bottom: 18px;
    padding-left: 22px;
}

.audio-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.audio-volume-slider {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    color: rgb(225, 232, 242);
    font-size: 16px;
}

.audio-volume-percentage {
    width: 56px;
    flex-shrink: 0;
    color: rgb(150, 205, 247);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    margin-left: 14px;
}

.audio-settings-actions {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.audio-settings-button {
    min-height: 38px;
    padding-top: 7px;
    padding-right: 16px;
    padding-bottom: 7px;
    padding-left: 16px;
    color: white;
    font-size: 15px;
    -unity-font-style: bold;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.audio-preview-button {
    background-color: rgb(44, 94, 156);
    margin-right: 12px;
}

.audio-preview-button:hover { background-color: rgb(58, 114, 184); }
.audio-preview-button:active { background-color: rgb(34, 76, 128); }

.audio-reset-button {
    background-color: rgb(86, 96, 110);
}

.audio-reset-button:hover { background-color: rgb(105, 116, 132); }
.audio-reset-button:active { background-color: rgb(67, 76, 88); }
.audio-settings-button:disabled { opacity: 0.45; }

.audio-settings-unavailable {
    color: rgb(246, 166, 166);
    font-size: 14px;
    margin-top: 12px;
}

.connection-page-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.connection-title {
    margin-bottom: 0;
}

.connection-status-pill {
    min-width: 96px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.connection-status-gray { background-color: rgb(86, 96, 110); }
.connection-status-yellow { background-color: rgb(185, 137, 42); }
.connection-status-blue { background-color: rgb(47, 107, 171); }
.connection-status-green { background-color: rgb(49, 137, 88); }
.connection-status-red { background-color: rgb(176, 63, 68); }

.connection-columns {
    flex-direction: row;
    flex-grow: 1;
}

.connection-card {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    background-color: rgb(30, 35, 45);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(58, 68, 84);
    border-right-color: rgb(58, 68, 84);
    border-bottom-color: rgb(58, 68, 84);
    border-left-color: rgb(58, 68, 84);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 22px;
    padding-right: 22px;
}

.connection-selection-card {
    margin-right: 18px;
}

.connection-card-title {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.connection-toggle {
    margin-bottom: 16px;
    color: rgb(225, 232, 242);
    font-size: 16px;
}

.connection-address {
    color: rgb(150, 205, 247);
    font-size: 15px;
    margin-bottom: 10px;
    white-space: normal;
}

.connection-restart-hint {
    color: rgb(174, 187, 205);
    font-size: 14px;
    margin-bottom: 20px;
    white-space: normal;
}

.connection-retest-button {
    min-height: 40px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 18px;
    padding-right: 18px;
    align-self: flex-start;
    background-color: rgb(44, 94, 156);
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.connection-retest-button:hover { background-color: rgb(58, 114, 184); }
.connection-retest-button:active { background-color: rgb(34, 76, 128); }
.connection-retest-button:disabled { opacity: 0.45; }

.connection-detail {
    color: rgb(202, 213, 228);
    font-size: 15px;
    margin-bottom: 10px;
    white-space: normal;
}

.connection-error {
    color: rgb(246, 166, 166);
}

.connection-readiness {
    margin-top: 6px;
    color: rgb(141, 218, 175);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
}
