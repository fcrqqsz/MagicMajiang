.lobby-root {
    flex-grow: 1;
    flex-direction: row;
    background-color: rgb(30, 30, 30);
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

.sidebar {
    width: 250px;
    background-color: rgb(20, 20, 20);
    padding: 20px;
}

.sidebar-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
    margin-bottom: 30px;
}

.nav-button {
    padding: 12px;
    font-size: 16px;
    background-color: transparent;
    color: rgb(180, 180, 180);
    border-width: 0;
    -unity-text-align: middle-left;
}

.nav-button:hover {
    background-color: rgb(40, 40, 40);
    color: white;
}

.nav-button.active-tab {
    background-color: rgb(60, 60, 60);
    color: white;
    -unity-font-style: bold;
}

.content-area {
    flex-grow: 1;
    padding: 40px;
}

.view-container {
    flex-grow: 1;
}

.view-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: white;
    margin-bottom: 10px;
}

.view-subtitle {
    font-size: 18px;
    color: rgb(180, 180, 180);
    margin-bottom: 30px;
}

.action-button {
    padding: 15px 30px;
    font-size: 24px;
    -unity-font-style: bold;
    background-color: rgb(200, 100, 50);
    color: white;
    border-radius: 8px;
    border-width: 0;
    align-self: flex-start;
}

.action-button:hover {
    background-color: rgb(220, 120, 70);
}

.action-button:active {
    background-color: rgb(180, 80, 30);
}

.deck-selector {
    flex-direction: row;
    align-items: center;
    margin-bottom: 30px;
}

.deck-arrow-btn {
    background-color: transparent;
    border-width: 0;
    font-size: 24px;
    color: rgb(180, 180, 180);
    padding: 8px 12px;
    border-radius: 4px;
}

.deck-arrow-btn:hover {
    color: white;
    background-color: rgb(60, 60, 60);
}

.deck-arrow-btn:disabled {
    opacity: 0.3;
}

.deck-name-display {
    flex-grow: 1;
    -unity-text-align: middle-center;
    margin-bottom: 0;
}

.room-preset-selector {
    margin-top: -14px;
    margin-bottom: 18px;
}

.room-admission-blocker {
    max-width: 620px;
    margin-bottom: 14px;
    padding: 10px 14px;
    background-color: rgb(82, 39, 43);
    border-left-width: 3px;
    border-left-color: rgb(255, 107, 107);
    border-radius: 5px;
}

.room-admission-blocker-label {
    color: rgb(255, 205, 205);
    font-size: 15px;
    white-space: normal;
}

.room-controls {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 20px;
    margin-bottom: 14px;
}

.room-id-input {
    width: 360px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 16px;
}

.room-id-input .unity-base-field__label {
    color: rgb(225, 225, 225);
    font-size: 16px;
    min-width: 155px;
    margin-right: 10px;
}

.room-id-input .unity-base-text-field__input {
    min-height: 36px;
    padding-left: 10px;
    padding-right: 10px;
    color: white;
    background-color: rgb(18, 18, 18);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(125, 145, 170);
    border-right-color: rgb(125, 145, 170);
    border-bottom-color: rgb(125, 145, 170);
    border-left-color: rgb(125, 145, 170);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.room-id-input .unity-base-text-field__input:focus {
    border-top-color: rgb(90, 170, 240);
    border-right-color: rgb(90, 170, 240);
    border-bottom-color: rgb(90, 170, 240);
    border-left-color: rgb(90, 170, 240);
}

.room-secondary-button {
    min-width: 140px;
    min-height: 38px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 8px 16px;
    background-color: rgb(55, 95, 145);
    color: white;
    border-width: 0;
    border-radius: 5px;
    font-size: 16px;
}

.room-ready-button {
    min-width: 300px;
    min-height: 48px;
    padding: 10px 22px;
    margin-bottom: 14px;
    background-color: rgb(55, 145, 90);
    color: white;
    border-width: 0;
    border-radius: 6px;
    font-size: 20px;
    -unity-font-style: bold;
    align-self: flex-start;
}

.room-ready-button:disabled {
    opacity: 0.45;
}

.room-view {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
}

.room-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 85, 104);
}

.room-title {
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
}

.room-state-label {
    color: rgb(132, 211, 255);
    font-size: 17px;
    -unity-font-style: bold;
}

.room-main-content {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    padding-top: 24px;
    padding-bottom: 18px;
}

.room-seat-section {
    flex-grow: 1;
    min-width: 420px;
    margin-right: 28px;
}

.room-summary-section {
    width: 300px;
    flex-shrink: 0;
    padding-left: 22px;
    border-left-width: 1px;
    border-left-color: rgb(66, 80, 98);
}

.room-section-title {
    color: rgb(230, 237, 246);
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.room-seat-list {
    flex-grow: 1;
    min-height: 264px;
    justify-content: space-between;
}

.room-seat-row {
    height: 58px;
    min-height: 58px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 8px;
    background-color: rgb(37, 43, 52);
    border-left-width: 3px;
    border-left-color: rgb(76, 89, 105);
    border-radius: 6px;
}

.room-seat-row-local {
    background-color: rgb(37, 62, 72);
    border-left-color: rgb(92, 205, 221);
}

.room-seat-number {
    width: 72px;
    color: rgb(156, 170, 188);
    font-size: 15px;
}

.room-seat-name {
    flex-grow: 1;
    min-width: 120px;
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
}

.room-seat-kind {
    width: 66px;
    color: rgb(185, 202, 220);
    -unity-text-align: middle-center;
}

.room-seat-alienation {
    width: 104px;
    color: rgb(242, 192, 111);
    -unity-text-align: middle-right;
}

.room-seat-ready {
    width: 86px;
    color: rgb(123, 219, 157);
    -unity-text-align: middle-right;
}

.room-detail-label {
    color: rgb(190, 204, 220);
    font-size: 16px;
    margin-bottom: 10px;
    white-space: normal;
}

.room-summary-divider {
    height: 1px;
    margin-top: 8px;
    margin-bottom: 18px;
    background-color: rgb(66, 80, 98);
}

.room-local-build-title {
    margin-top: 0;
}

.room-alienation-label {
    color: rgb(242, 192, 111);
}

.room-lock-label {
    margin-top: 8px;
    color: rgb(123, 219, 157);
    font-size: 15px;
    -unity-font-style: bold;
}

.room-footer {
    min-height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgb(70, 85, 104);
}

.room-waiting-label {
    flex-grow: 1;
    color: rgb(181, 196, 215);
    font-size: 16px;
    white-space: normal;
}

.room-actions {
    flex-direction: row;
    align-items: center;
}

.room-leave-button,
.room-confirm-ready-button {
    min-width: 138px;
    min-height: 40px;
    margin-left: 12px;
    padding: 8px 16px;
    color: white;
    border-width: 0;
    border-radius: 6px;
    font-size: 16px;
    -unity-font-style: bold;
}

.room-leave-button {
    background-color: rgb(118, 67, 69);
}

.room-confirm-ready-button {
    background-color: rgb(55, 145, 90);
}

.room-confirm-ready-button:disabled {
    opacity: 0.45;
}
