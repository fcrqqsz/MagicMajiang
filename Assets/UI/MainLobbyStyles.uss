.lobby-root {
    flex-grow: 1;
    flex-direction: row;
    background-color: #071a1b;
    color: #d9e7df;
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
}

/* --------------------------------------------------------------------------
   Sidebar Navigation
   -------------------------------------------------------------------------- */
.sidebar {
    width: 240px;
    min-width: 240px;
    flex-shrink: 0;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 24px;
    padding-bottom: 20px;
    background-color: #0a2423;
    border-right-width: 1px;
    border-right-style: solid;
    border-right-color: #274740;
}

.sidebar-brand {
    margin-bottom: 28px;
}

.sidebar-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: #f0ead4;
    letter-spacing: 1px;
    margin-bottom: 0;
}

.sidebar-tag {
    margin-top: 4px;
    color: #e2c47d;
    font-size: 11px;
    letter-spacing: 2px;
}

.nav-group {
    flex-grow: 1;
}

.nav-button {
    min-height: 42px;
    margin-bottom: 8px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: transparent;
    color: #8faea6;
    font-size: 15px;
    border-left-width: 3px;
    border-left-style: solid;
    border-left-color: transparent;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    -unity-text-align: middle-left;
}

.nav-button:hover {
    background-color: #10322f;
    color: #e5f1ec;
}

.nav-button.active-tab {
    background-color: #143e39;
    color: #f0ead4;
    -unity-font-style: bold;
    border-left-color: #579384;
}

.nav-button.nav-button-disabled {
    opacity: 0.45;
}

.sidebar-footer {
    padding-top: 14px;
    border-top-width: 1px;
    border-top-style: solid;
    border-top-color: #1c3c38;
}

.sidebar-version {
    color: #587971;
    font-size: 11px;
}

.sidebar-copyright {
    margin-top: 2px;
    color: #4b6760;
    font-size: 11px;
}

/* --------------------------------------------------------------------------
   Content Area & Top Bar
   -------------------------------------------------------------------------- */
.content-area {
    flex-grow: 1;
    flex-shrink: 1;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 20px;
    padding-bottom: 20px;
    height: 100%;
    min-height: 0;
    overflow: hidden;
}

.view-container {
    flex-grow: 1;
    height: 100%;
    min-height: 0;
}

.home-view-container {
    flex-grow: 1;
    height: 100%;
    min-height: 0;
}

.home-top-bar {
    flex-direction: row;
    align-items: center;
    min-height: 68px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: #0d2928;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #2d514b;
    border-right-color: #2d514b;
    border-top-color: #2d514b;
    border-bottom-color: #2d514b;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.brand-block {
    width: 26%;
}

.eyebrow {
    color: #77b9aa;
    font-size: 12px;
    letter-spacing: 2px;
}

.welcome-title {
    margin-top: 4px;
    color: #f0ead4;
    font-size: 20px;
    -unity-font-style: bold;
}

.meta-strip {
    flex-direction: row;
    align-items: stretch;
    width: 54%;
}

.meta-cell {
    justify-content: center;
    flex-grow: 1;
    min-height: 42px;
    margin-left: 8px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: #102f2d;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #24443f;
    border-right-color: #24443f;
    border-top-color: #24443f;
    border-bottom-color: #24443f;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.meta-label {
    color: #78978f;
    font-size: 11px;
}

.meta-value {
    margin-top: 3px;
    color: #e5eee9;
    font-size: 14px;
    -unity-font-style: bold;
}

.meta-value-gold {
    color: #e2c47d;
}

.connection-block {
    align-items: flex-end;
    justify-content: center;
    width: 20%;
}

.connection-good {
    color: #79d2b5;
    -unity-font-style: bold;
    font-size: 13px;
}

.connection-sub {
    margin-top: 4px;
    color: #77948d;
    font-size: 11px;
}

/* --------------------------------------------------------------------------
   Home Body (2-Column Dashboard)
   -------------------------------------------------------------------------- */
.home-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 540px;
    margin-top: 14px;
}

.section-heading {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    margin-bottom: 10px;
}

.section-title {
    color: #eadfbd;
    font-size: 18px;
    -unity-font-style: bold;
}

.section-caption {
    margin-left: 12px;
    color: #718e87;
    font-size: 12px;
}

/* --------------------------------------------------------------------------
   Left Column: Deck Dashboard Panel
   -------------------------------------------------------------------------- */
.deck-dashboard-panel {
    width: 44%;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 16px;
    background-color: #0a2423;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #274740;
    border-right-color: #274740;
    border-top-color: #274740;
    border-bottom-color: #274740;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.deck-main-card {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    background-color: #102e2c;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #34534c;
    border-right-color: #34534c;
    border-top-color: #34534c;
    border-bottom-color: #34534c;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.deck-carousel-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: #091f1e;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #26433e;
    border-right-color: #26433e;
    border-top-color: #26433e;
    border-bottom-color: #26433e;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.arrow-btn {
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: #173b37;
    color: #9ed2c5;
    font-size: 16px;
    -unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #39645c;
    border-right-color: #39645c;
    border-top-color: #39645c;
    border-bottom-color: #39645c;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-text-align: middle-center;
}

.arrow-btn:hover {
    background-color: #22564f;
}

.arrow-btn:disabled {
    opacity: 0.35;
}

.deck-name-container {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.deck-name-label {
    color: #f0ead4;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.deck-preset-badge {
    margin-top: 3px;
    color: #79a69b;
    font-size: 11px;
    -unity-text-align: middle-center;
}

/* 预算表盘 */
.budget-panel {
    margin-top: 14px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: #0b2523;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.budget-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.budget-title {
    color: #8faea6;
    font-size: 12px;
}

.budget-total-text {
    color: #e2c47d;
    font-size: 15px;
    -unity-font-style: bold;
}

.progress-track {
    height: 8px;
    margin-top: 8px;
    background-color: #13332f;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background-color: #55b29b;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.progress-fill.progress-overflow {
    background-color: #d25a3d;
}

.budget-breakdown-row {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.breakdown-item {
    margin-right: 12px;
    color: #799a92;
    font-size: 11px;
}

.breakdown-tag {
    margin-left: auto;
    font-size: 11px;
}

.breakdown-valid {
    color: #70c6ad;
    -unity-font-style: bold;
}

.breakdown-invalid {
    color: #d25a3d;
    -unity-font-style: bold;
}

/* 天赋摘要预览 */
.talents-preview-box {
    margin-top: 14px;
}

.talents-preview-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.talents-box-title {
    color: #9cb5ae;
    font-size: 12px;
    -unity-font-style: bold;
}

.talents-sideboard-header {
    margin-top: 10px;
}

.talent-chips-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.talent-chip {
    flex-direction: row;
    align-items: center;
    width: 31.8%;
    min-width: 31.8%;
    max-width: 31.8%;
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 32px;
    height: 32px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: #0c2624;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #274741;
    border-right-color: #274741;
    border-top-color: #274741;
    border-bottom-color: #274741;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    overflow: hidden;
}

.chip-tier-tag {
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-right: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.chip-name {
    align-items: center;
    flex-grow: 1;
    color: #dbebe5;
    font-size: 12px;
    overflow: hidden;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.chip-major {
    background-color: #26241a;
    border-left-color: #705828;
    border-right-color: #705828;
    border-top-color: #705828;
    border-bottom-color: #705828;
}

.chip-major .chip-tier-tag {
    background-color: #4f3b14;
    color: #e2c47d;
}

.chip-medium {
    background-color: #102e2a;
    border-left-color: #2f5d54;
    border-right-color: #2f5d54;
    border-top-color: #2f5d54;
    border-bottom-color: #2f5d54;
}

.chip-medium .chip-tier-tag {
    background-color: #1e534a;
    color: #9dd7c9;
}

.chip-minor {
    background-color: #0e2725;
    border-left-color: #244641;
    border-right-color: #244641;
    border-top-color: #244641;
    border-bottom-color: #244641;
}

.chip-minor .chip-tier-tag {
    background-color: #173d38;
    color: #79baa9;
}

.chip-sideboard {
    border-left-style: dashed;
    border-right-style: dashed;
    border-top-style: dashed;
    border-bottom-style: dashed;
    opacity: 0.88;
}

.chip-sideboard:hover {
    opacity: 1;
}

.chip-empty {
    background-color: #081d1b;
    border-left-style: dashed;
    border-right-style: dashed;
    border-top-style: dashed;
    border-bottom-style: dashed;
    border-left-color: #213c37;
    border-right-color: #213c37;
    border-top-color: #213c37;
    border-bottom-color: #213c37;
}

.chip-empty .chip-tier-tag {
    background-color: #122c28;
    color: #587971;
}

.chip-empty .chip-name {
    color: #55756d;
}

/* 按钮与提示 */
.deck-action-row {
    flex-direction: row;
    margin-top: 14px;
}

.workshop-jump-btn {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    height: 38px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: #173b37;
    color: #a9d6ca;
    font-size: 14px;
    -unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #3e756b;
    border-right-color: #3e756b;
    border-top-color: #3e756b;
    border-bottom-color: #3e756b;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    -unity-text-align: middle-center;
}

.workshop-jump-btn:hover {
    background-color: #205149;
    color: #d6eee7;
}

.info-note {
    flex-direction: row;
    margin-top: 14px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: #0e2725;
    border-left-width: 3px;
    border-left-style: solid;
    border-left-color: #4f9787;
    border-top-left-radius: 0;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 5px;
}

.info-note-text {
    color: #8faaa3;
    font-size: 12px;
    white-space: normal;
}

/* --------------------------------------------------------------------------
   Right Column: Match Config Panel
   -------------------------------------------------------------------------- */
.match-config-panel {
    width: 56%;
    margin-left: 14px;
}

/* 规则与档位卡片 */
.config-card {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 16px;
    padding-bottom: 16px;
    background-color: #0a2423;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #274740;
    border-right-color: #274740;
    border-top-color: #274740;
    border-bottom-color: #274740;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.selector-container {
    margin-top: 4px;
}

.selector-container-spaced {
    margin-top: 12px;
}

.field-caption {
    margin-bottom: 6px;
    color: #9cb5ae;
    font-size: 12px;
    -unity-font-style: bold;
}

.carousel-selector-bar {
    flex-direction: row;
    align-items: center;
    min-height: 56px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: #102e2c;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #31534c;
    border-right-color: #31534c;
    border-top-color: #31534c;
    border-bottom-color: #31534c;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.carousel-arrow-btn {
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 38px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: #173b37;
    color: #9ed2c5;
    font-size: 16px;
    -unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #39645c;
    border-right-color: #39645c;
    border-top-color: #39645c;
    border-bottom-color: #39645c;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-text-align: middle-center;
}

.carousel-arrow-btn:hover {
    background-color: #22564f;
}

.carousel-content-block {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    padding-left: 12px;
    padding-right: 12px;
}

.carousel-title-row {
    flex-direction: row;
    align-items: center;
}

.carousel-title {
    color: #f0ead4;
    font-size: 16px;
    -unity-font-style: bold;
}

.carousel-desc {
    margin-top: 3px;
    color: #7b9c93;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.badge {
    align-items: center;
    justify-content: center;
    min-height: 20px;
    margin-left: 8px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 11px;
}

.badge-gold {
    background-color: #3d3422;
    color: #e2c47d;
    border-left-color: #8b713e;
    border-right-color: #8b713e;
    border-top-color: #8b713e;
    border-bottom-color: #8b713e;
}

.badge-ready {
    background-color: #143f35;
    color: #80dabd;
    border-left-color: #34685f;
    border-right-color: #34685f;
    border-top-color: #34685f;
    border-bottom-color: #34685f;
}

/* 快速起局卡片 */
.action-card {
    margin-top: 12px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: #0a2423;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #274740;
    border-right-color: #274740;
    border-top-color: #274740;
    border-bottom-color: #274740;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.action-heading-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.card-subtitle {
    color: #f0e5c6;
    font-size: 15px;
    -unity-font-style: bold;
}

.card-caption {
    margin-left: 10px;
    color: #68857d;
    font-size: 11px;
}

.action-btn-row {
    flex-direction: row;
}

.btn-create-room {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    height: 44px;
    margin-right: 10px;
    margin-left: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: #1c5048;
    color: #e2f1eb;
    font-size: 16px;
    -unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #579384;
    border-right-color: #579384;
    border-top-color: #579384;
    border-bottom-color: #579384;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    -unity-text-align: middle-center;
}

.btn-create-room:hover {
    background-color: #25675c;
}

.btn-create-room:active {
    background-color: #18443e;
}

.btn-view-rooms {
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    height: 44px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: #173b37;
    color: #a9d6ca;
    font-size: 15px;
    -unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #3e756b;
    border-right-color: #3e756b;
    border-top-color: #3e756b;
    border-bottom-color: #3e756b;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    -unity-text-align: middle-center;
}

.btn-view-rooms:hover {
    background-color: #205149;
    color: #def2eb;
}

/* 房间号直连卡片 */
.direct-join-card {
    margin-top: 12px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: #0a2423;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #274740;
    border-right-color: #274740;
    border-top-color: #274740;
    border-bottom-color: #274740;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.join-input-row {
    flex-direction: row;
    align-items: center;
}

.room-input-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 40px;
    margin-right: 10px;
    padding-left: 12px;
    padding-right: 10px;
    background-color: #091f1e;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #2a4c46;
    border-right-color: #2a4c46;
    border-top-color: #2a4c46;
    border-bottom-color: #2a4c46;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.room-id-textfield {
    flex-grow: 1;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.room-id-textfield .unity-base-text-field__input {
    background-color: transparent;
    color: #e5eee9;
    font-size: 14px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-left;
}

.input-auto-upper-tag {
    color: #55756c;
    font-size: 11px;
}

.btn-join-room {
    align-items: center;
    justify-content: center;
    min-width: 130px;
    height: 40px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0;
    padding-bottom: 0;
    background-color: #1a423d;
    color: #d2ebe3;
    font-size: 14px;
    -unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-style: solid;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-left-color: #3b6b62;
    border-right-color: #3b6b62;
    border-top-color: #3b6b62;
    border-bottom-color: #3b6b62;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    -unity-text-align: middle-center;
}

.btn-join-room:hover {
    background-color: #235952;
}

/* 状态与警示栏 */
.status-strip {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: #0b2523;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.status-indicator {
    flex-direction: row;
    align-items: center;
}

.status-dot {
    width: 8px;
    height: 8px;
    margin-right: 8px;
    background-color: #79d2b5;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.status-text {
    color: #7fa198;
    font-size: 12px;
}

.admission-blocker {
    margin-top: 10px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: #2d1d16;
    border-left-width: 3px;
    border-left-style: solid;
    border-left-color: #b05c3b;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-style: solid;
    border-top-style: solid;
    border-bottom-style: solid;
    border-right-color: #553424;
    border-top-color: #553424;
    border-bottom-color: #553424;
    border-top-left-radius: 0;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 6px;
}

.blocker-title {
    color: #e59370;
    font-size: 12px;
    -unity-font-style: bold;
}

.blocker-text {
    margin-top: 3px;
    color: #d1b1a3;
    font-size: 12px;
    white-space: normal;
}

/* 兼容旧类名与通用定义 */
.view-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #f0ead4;
    margin-bottom: 10px;
}

.view-subtitle {
    font-size: 14px;
    color: #8faea6;
    margin-bottom: 20px;
}

.action-button {
    padding: 12px 24px;
    font-size: 18px;
    -unity-font-style: bold;
    background-color: #1c5048;
    color: white;
    border-radius: 6px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.action-button:hover {
    background-color: #25675c;
}

.home-action-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.room-browser-button {
    background-color: #173b37;
    margin-left: 12px;
}

.room-admission-blocker {
    max-width: 620px;
    margin-bottom: 14px;
    padding: 10px 14px;
    background-color: #2d1d16;
    border-left-width: 3px;
    border-left-color: #b05c3b;
    border-radius: 5px;
}

.room-admission-blocker-label {
    color: #d1b1a3;
    font-size: 14px;
    white-space: normal;
}

.room-ready-button {
    min-width: 300px;
    min-height: 48px;
    padding: 10px 22px;
    margin-bottom: 14px;
    background-color: rgb(55, 145, 90);
    color: white;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 6px;
    font-size: 20px;
    -unity-font-style: bold;
    align-self: flex-start;
}

.room-ready-button:disabled {
    opacity: 0.45;
}

.room-view {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
}

.room-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(70, 85, 104);
}

.room-title {
    color: white;
    font-size: 32px;
    -unity-font-style: bold;
}

.room-state-label {
    color: rgb(132, 211, 255);
    font-size: 17px;
    -unity-font-style: bold;
}

.room-main-content {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    padding-top: 24px;
    padding-bottom: 18px;
}

.room-seat-section {
    flex-grow: 1;
    min-width: 420px;
    margin-right: 28px;
}

.room-summary-section {
    width: 300px;
    flex-shrink: 0;
    padding-left: 22px;
    border-left-width: 1px;
    border-left-color: rgb(66, 80, 98);
}

.room-section-title {
    color: rgb(230, 237, 246);
    font-size: 19px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.room-seat-list {
    flex-grow: 1;
    min-height: 264px;
    justify-content: space-between;
}

.room-seat-row {
    height: 58px;
    min-height: 58px;
    flex-direction: row;
    align-items: center;
    padding-left: 14px;
    padding-right: 14px;
    margin-bottom: 8px;
    background-color: rgb(37, 43, 52);
    border-left-width: 3px;
    border-left-color: rgb(76, 89, 105);
    border-radius: 6px;
}

.room-seat-row-local {
    background-color: rgb(37, 62, 72);
    border-left-color: rgb(92, 205, 221);
}

.room-seat-number {
    width: 72px;
    color: rgb(156, 170, 188);
    font-size: 15px;
}

.room-seat-name {
    flex-grow: 1;
    min-width: 120px;
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
}

.room-seat-kind {
    width: 66px;
    color: rgb(185, 202, 220);
    -unity-text-align: middle-center;
}

.room-seat-ready {
    width: 86px;
    color: rgb(123, 219, 157);
    -unity-text-align: middle-right;
}

.room-detail-label {
    color: rgb(190, 204, 220);
    font-size: 16px;
    margin-bottom: 10px;
    white-space: normal;
}

.room-summary-divider {
    height: 1px;
    margin-top: 8px;
    margin-bottom: 18px;
    background-color: rgb(66, 80, 98);
}

.room-local-build-title {
    margin-top: 0;
}

.room-alienation-label {
    color: rgb(242, 192, 111);
}

.room-lock-label {
    margin-top: 8px;
    color: rgb(123, 219, 157);
    font-size: 15px;
    -unity-font-style: bold;
}

.room-footer {
    min-height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgb(70, 85, 104);
}

.room-waiting-label {
    flex-grow: 1;
    color: rgb(181, 196, 215);
    font-size: 16px;
    white-space: normal;
}

.room-actions {
    flex-direction: row;
    align-items: center;
}

.room-leave-button,
.room-confirm-ready-button {
    min-width: 138px;
    min-height: 40px;
    margin-left: 12px;
    padding: 8px 16px;
    color: white;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 6px;
    font-size: 16px;
    -unity-font-style: bold;
}

.room-leave-button {
    background-color: rgb(118, 67, 69);
}

.room-confirm-ready-button {
    background-color: rgb(55, 145, 90);
}

.room-confirm-ready-button:disabled {
    opacity: 0.45;
}

/* ========================================================
   Compendium (图鉴与规则速查) 样式
   ======================================================== */

.compendium-header {
    flex-shrink: 0;
    margin-bottom: 12px;
}

.compendium-header .view-title {
    margin-bottom: 4px;
}

.compendium-header .view-subtitle {
    margin-bottom: 0;
}

.compendium-subtab-bar {
    flex-shrink: 0;
    flex-direction: row;
    background-color: rgb(18, 20, 24);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
    margin-bottom: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(42, 48, 60);
    border-right-color: rgb(42, 48, 60);
    border-bottom-color: rgb(42, 48, 60);
    border-left-color: rgb(42, 48, 60);
}

.compendium-subtab-btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 15px;
    color: rgb(160, 170, 185);
    background-color: transparent;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    -unity-font-style: bold;
}

.compendium-subtab-btn:hover {
    color: white;
    background-color: rgb(32, 38, 50);
}

.compendium-subtab-btn.compendium-subtab-active {
    color: white;
    background-color: rgb(44, 94, 156);
}

.compendium-subview {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.compendium-toolbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(40, 46, 58);
}

.compendium-filter-group {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.compendium-filter-btn {
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 13px;
    background-color: rgb(35, 40, 50);
    color: rgb(180, 190, 205);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(55, 62, 78);
    border-right-color: rgb(55, 62, 78);
    border-bottom-color: rgb(55, 62, 78);
    border-left-color: rgb(55, 62, 78);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-right: 6px;
    margin-bottom: 4px;
}

.compendium-filter-btn:hover {
    background-color: rgb(48, 56, 72);
    color: white;
}

.compendium-filter-btn.compendium-filter-active {
    background-color: rgb(92, 205, 221);
    color: rgb(15, 25, 35);
    border-top-color: rgb(92, 205, 221);
    border-right-color: rgb(92, 205, 221);
    border-bottom-color: rgb(92, 205, 221);
    border-left-color: rgb(92, 205, 221);
    -unity-font-style: bold;
}

.compendium-search-field {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
    height: 34px;
}

.compendium-search-field .unity-base-field__label {
    min-width: 0;
    width: auto;
    font-size: 13px;
    color: rgb(170, 185, 205);
    -unity-font-style: bold;
    margin-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.compendium-search-field .unity-base-text-field__input {
    width: 220px;
    height: 34px;
    background-color: rgb(18, 20, 24);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(55, 65, 80);
    border-right-color: rgb(55, 65, 80);
    border-bottom-color: rgb(55, 65, 80);
    border-left-color: rgb(55, 65, 80);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 10px;
    padding-right: 10px;
    color: white;
    font-size: 13px;
}

/* 鼠标悬停微高亮 */
.compendium-search-field .unity-base-text-field__input:hover {
    border-top-color: rgb(85, 100, 125);
    border-right-color: rgb(85, 100, 125);
    border-bottom-color: rgb(85, 100, 125);
    border-left-color: rgb(85, 100, 125);
    background-color: rgb(24, 28, 36);
}

/* 获得焦点待输入时的高亮提示（霓虹青边框 + 提亮背景色 + 边框加粗视觉） */
.compendium-search-field .unity-base-text-field__input:focus {
    background-color: rgb(26, 36, 50);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(92, 205, 221);
    border-right-color: rgb(92, 205, 221);
    border-bottom-color: rgb(92, 205, 221);
    border-left-color: rgb(92, 205, 221);
}

/* 焦点激活状态时标签联动高亮 */
.compendium-search-field.compendium-search-focused .unity-base-field__label {
    color: rgb(92, 205, 221);
}

.compendium-stats-bar {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    padding-left: 2px;
    padding-right: 2px;
}

.compendium-stats-text {
    font-size: 13px;
    color: rgb(140, 150, 165);
}

.compendium-stats-hint {
    font-size: 13px;
    color: rgb(242, 192, 111);
    -unity-font-style: bold;
}

.compendium-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-right: 6px;
}

/* 番种/天赋卡片通用样式 */
.compendium-card {
    flex-direction: column;
    background-color: rgb(32, 36, 46);
    border-left-width: 4px;
    border-left-color: rgb(70, 80, 100);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(45, 50, 62);
    border-right-color: rgb(45, 50, 62);
    border-bottom-color: rgb(45, 50, 62);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-right: 16px;
    margin-bottom: 10px;
}

.compendium-card:hover {
    background-color: rgb(38, 44, 56);
    border-left-color: rgb(92, 205, 221);
}

.compendium-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.compendium-card-title-group {
    flex-direction: row;
    align-items: center;
}

.compendium-card-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: white;
    margin-right: 10px;
}

.compendium-card-badge {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(180, 110, 40);
}

.badge-fan-top { background-color: rgb(215, 60, 60); }
.badge-fan-high { background-color: rgb(190, 110, 40); }
.badge-fan-mid { background-color: rgb(45, 110, 160); }
.badge-fan-low { background-color: rgb(80, 85, 105); }

.badge-tier-major { background-color: rgb(215, 60, 60); }
.badge-tier-medium { background-color: rgb(190, 110, 40); }
.badge-tier-minor { background-color: rgb(45, 110, 160); }

.compendium-card-meta-right {
    flex-direction: row;
    align-items: center;
}

.compendium-meta-tag {
    font-size: 12px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: rgb(22, 25, 32);
    color: rgb(160, 175, 195);
    margin-left: 8px;
}

.compendium-meta-tag-active {
    color: rgb(242, 192, 111);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(160, 120, 50);
    border-right-color: rgb(160, 120, 50);
    border-bottom-color: rgb(160, 120, 50);
    border-left-color: rgb(160, 120, 50);
}

.compendium-card-desc {
    font-size: 14px;
    color: rgb(200, 205, 215);
    white-space: normal;
    margin-bottom: 4px;
}

.compendium-card-extra {
    flex-direction: row;
    align-items: center;
    font-size: 13px;
    color: rgb(230, 140, 140);
    background-color: rgb(42, 28, 30);
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-top: 4px;
    white-space: normal;
}

.compendium-card-extra-talent {
    color: rgb(160, 205, 235);
    background-color: rgb(25, 38, 48);
}

/* 核心机制卡片 */
.compendium-mechanic-card {
    flex-direction: column;
    background-color: rgb(30, 34, 44);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 18px;
    padding-bottom: 18px;
    padding-left: 20px;
    padding-right: 20px;
    margin-bottom: 16px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(45, 52, 66);
    border-right-color: rgb(45, 52, 66);
    border-bottom-color: rgb(45, 52, 66);
    border-left-color: rgb(45, 52, 66);
}

.compendium-mechanic-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(45, 52, 66);
}

.compendium-mechanic-badge {
    width: 24px;
    height: 24px;
    background-color: rgb(44, 94, 156);
    color: white;
    -unity-font-style: bold;
    font-size: 13px;
    -unity-text-align: middle-center;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    margin-right: 10px;
}

.compendium-mechanic-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
}

.compendium-mechanic-desc {
    font-size: 14px;
    color: rgb(195, 205, 220);
    white-space: normal;
    margin-bottom: 10px;
}

.compendium-mechanic-box {
    flex-direction: column;
    background-color: rgb(22, 26, 34);
    border-left-width: 3px;
    border-left-color: rgb(242, 192, 111);
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.compendium-box-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(242, 192, 111);
    margin-bottom: 4px;
}

.compendium-box-desc {
    font-size: 13px;
    color: rgb(180, 190, 205);
    white-space: normal;
}

/* Connection settings */
.settings-view {
    flex-direction: column;
}

.settings-scroll-view {
    flex-grow: 1;
    min-height: 0;
}

.settings-page-title {
    margin-bottom: 22px;
}

.settings-section {
    flex-direction: column;
    margin-bottom: 28px;
}

.settings-section-title {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.connection-page-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.connection-title {
    margin-bottom: 0;
}

.connection-status-pill {
    min-width: 96px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.connection-status-gray { background-color: rgb(86, 96, 110); }
.connection-status-yellow { background-color: rgb(185, 137, 42); }
.connection-status-blue { background-color: rgb(47, 107, 171); }
.connection-status-green { background-color: rgb(49, 137, 88); }
.connection-status-red { background-color: rgb(176, 63, 68); }

.connection-columns {
    flex-direction: row;
    flex-grow: 1;
}

.connection-card {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
    background-color: rgb(30, 35, 45);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(58, 68, 84);
    border-right-color: rgb(58, 68, 84);
    border-bottom-color: rgb(58, 68, 84);
    border-left-color: rgb(58, 68, 84);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 22px;
    padding-right: 22px;
}

.connection-selection-card {
    margin-right: 18px;
}

.connection-card-title {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.connection-toggle {
    margin-bottom: 16px;
    color: rgb(225, 232, 242);
    font-size: 16px;
}

.connection-address {
    color: rgb(150, 205, 247);
    font-size: 15px;
    margin-bottom: 10px;
    white-space: normal;
}

.connection-restart-hint {
    color: rgb(174, 187, 205);
    font-size: 14px;
    margin-bottom: 20px;
    white-space: normal;
}

.connection-retest-button {
    min-height: 40px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 18px;
    padding-right: 18px;
    align-self: flex-start;
    background-color: rgb(44, 94, 156);
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.connection-retest-button:hover { background-color: rgb(58, 114, 184); }
.connection-retest-button:active { background-color: rgb(34, 76, 128); }
.connection-retest-button:disabled { opacity: 0.45; }

.connection-detail {
    color: rgb(202, 213, 228);
    font-size: 15px;
    margin-bottom: 10px;
    white-space: normal;
}

.connection-error {
    color: rgb(246, 166, 166);
}

.connection-readiness {
    margin-top: 6px;
    color: rgb(141, 218, 175);
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
}
