<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="main-container">
        <ui:VisualElement name="EditorArea" class="editor-area">
            <ui:VisualElement class="header-container">
                <ui:VisualElement class="header-stats">
                    <ui:Label name="TotalText" text="Total: 0 / 34" class="stat-label" />
                    <ui:VisualElement class="alienation-gauge-panel">
                        <ui:VisualElement name="AlienationPresetSelector" class="alienation-selector">
                            <ui:Button name="BtnPresetPrev" text="‹" class="preset-arrow" />
                            <ui:Label name="PresetLabel" text="标准 80" class="preset-label" />
                            <ui:Button name="BtnPresetNext" text="›" class="preset-arrow" />
                        </ui:VisualElement>
                        <ui:VisualElement name="AlienationTrack" class="alienation-track">
                            <ui:VisualElement name="AlienationFill" class="alienation-fill" />
                        </ui:VisualElement>
                        <ui:Label name="AlienationBreakdownLabel" class="alienation-breakdown" />
                        <ui:Label name="AlienationWarning" class="alienation-warning" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="header-controls">
                    <ui:Button name="BtnClearAll" text="清空" class="control-btn" />
                    <ui:Button name="BtnResetAll" text="重置" class="control-btn" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:ScrollView class="grid-scroll-view">
                <ui:VisualElement name="MainGrid" class="main-grid">
                    <!-- Each row will be created dynamically in C# -->
                </ui:VisualElement>
                <ui:VisualElement name="TalentSlotsSection" class="talent-section">
                    <ui:Label text="主天赋（开局激活）" class="talent-section-header" />
                    <ui:VisualElement name="MainTalentSlots" class="talent-slots-row" />
                    <ui:Label text="备选天赋（局间调整）" class="talent-section-header talent-reserve-header" />
                    <ui:VisualElement name="ReserveTalentSlots" class="talent-slots-row" />
                    <ui:Label name="TalentDetailLabel" class="talent-detail-label" />
                </ui:VisualElement>
            </ui:ScrollView>

            <ui:VisualElement class="footer-container">
                <ui:Button name="BtnSave" text="保存" class="footer-btn footer-btn-save" />
                <ui:Button name="BtnExit" text="退出" class="footer-btn footer-btn-exit" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="DeckSidebar" class="deck-sidebar">
            <ui:Label text="牌库列表" class="sidebar-title" />
            <ui:ScrollView name="DeckListScroll" class="deck-list-scroll">
                <ui:VisualElement name="DeckListContainer" class="deck-list-container" />
            </ui:ScrollView>
            <ui:Button name="BtnNewDeck" text="＋ 新建牌库" class="btn-new-deck" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
