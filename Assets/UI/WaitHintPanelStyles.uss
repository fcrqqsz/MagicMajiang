.wait-hint-root {
    position: absolute;
    /* 强制相对于屏幕计算 */
    left: 50%;
    translate: -50% 0;
    margin-left: 75px; /* 这样会在 translate 居中的基础上再向右偏移 75px */
    
    bottom: 350px;
    
    background-color: rgba(0, 0, 0, 0.85);
    border-radius: 15px; /* 圆角也适当放大 */
    padding: 15px; /* 内边距放大 */
    flex-direction: row;
    align-items: center;
    border-width: 3px; /* 边框加粗 */
    border-color: #D4AF37;
    
    /* 默认隐藏 */
    display: none; 
    
    /* 尺寸整体放大 */
    height: 180px; /* 原 120px */
    width: auto;
    min-width: 300px;
    /* 13张牌，每张 90px (含边距 20px)，加上左侧标题的宽度(约 120px) 和内边距，需要约 1400px */
    max-width: 1800px; 
    
    /* 确保在最上层 */
    z-index: 999;
}

.wait-hint-title {
    color: white;
    font-size: 42px; /* 原 32px */
    -unity-font-style: bold;
    margin-right: 25px;
    margin-left: 20px;
    -unity-text-align: middle-center;
}

.wait-list-scroll {
    flex-direction: row;
    height: 150px; /* 原 100px */
    flex-grow: 1;
}

.wait-list-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: center;
}

.wait-item {
    align-items: center;
    margin-right: 20px;
    width: 90px; /* 原 60px */
    height: 150px; /* 原 100px */
    justify-content: center;
}

.wait-item-image {
    width: 75px; /* 原 50px */
    height: 105px; /* 原 70px */
    background-color: white;
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.wait-item-fan {
    color: #FFD700;
    font-size: 24px; /* 原 18px */
    -unity-font-style: bold;
    margin-top: 10px;
}

/* 字体修正 (确保显示中文) */
.unity-text-element {
    -unity-font-definition: url('project://database/Assets/Font/MSYH.TTC');
}