<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="FloatingTilePanelStyles.uss" />
    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; picking-mode: Ignore;">
        <ui:VisualElement name="FloatingTilePanelRoot" class="floating-panel-root" picking-mode="Ignore">
            <ui:VisualElement name="FloatingPanelBody" class="floating-panel-body">
                <ui:Label name="FloatingPanelTitle" text="窥探" class="floating-panel-title" />
                <ui:ScrollView name="FloatingTileScroll" mode="Horizontal" class="floating-tile-scroll">
                    <!-- items added dynamically -->
                </ui:ScrollView>
                <ui:Button name="FloatingPanelCloseBtn" text="知道了" class="floating-panel-close-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
