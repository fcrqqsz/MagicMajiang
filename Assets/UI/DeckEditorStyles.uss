/* 全局字体设置 */
.unity-text-element {
    /* 这里的路径需要指向你之前生成的 .asset 字体文件 */
    /* 请确保文件名和路径完全一致 */
    -unity-font-definition: url('project://database/Assets/Font/MSYH.TTC');
}

/* 全局容器设置 */
.main-container {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.9);
    padding: 20px;
}

/* 顶部状态栏 */
.header-container {
    flex-direction: row;
    justify-content: space-between;
    height: 60px;
    margin-bottom: 20px;
    background-color: #2a2a2a;
    border-radius: 10px;
    padding: 10px 20px;
    align-items: center;
}

.stat-label {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
}

.text-red { color: #ff5555; }
.text-green { color: #55ff55; }
.text-white { color: #ffffff; }

/* 中间网格区域 */
.grid-scroll-view {
    flex-grow: 1;
    width: 100%;  /* 宽度撑满 */
    margin-bottom: 20px;
}

.grid-container {
    flex-direction: row;
    flex-wrap: wrap;             /* 允许换行 */
    
    /* 1. 水平方向：保持居中（这样每行不满时也会居中） */
    justify-content: center;     
    
    /* 2. 关键修复：多行内容的垂直对齐方式 */
    /* flex-start 强制所有行紧靠容器顶部，而不是分散在中间或两端 */
    align-content: flex-start;   
    
    /* 3. 关键修复：单行内的垂直对齐 */
    align-items: flex-start;     
    
    /* 4. 增加内边距，防止内容贴边 */
    padding-bottom: 50px;        
}

/* 修改 .tile-item */
.tile-item {
    width: 90px;
    height: 130px;
    
    /* 5. 关键修复：增加卡片之间的间距 */
    /* 尤其是 margin-bottom，这是解决“第二行遮挡第一行按钮”的核心 */
    margin-left: 10px;
    margin-right: 10px;
    margin-top: 10px;
    margin-bottom: 75px; /* 稍微大一点，确保按钮不被遮挡 */
    
    background-color: #3e3e3e;
    border-radius: 8px;
    border-width: 2px;
    border-color: #555;
    align-items: center;
    justify-content: space-between;
    padding: 5px;
}

.tile-face {
    font-size: 36px;
    color: white;
    -unity-text-align: middle-center;
    margin-top: 5px;
}

.tile-count {
    font-size: 24px;
    color: #aaaaaa;
    -unity-font-style: bold;
}

.tile-count.active {
    color: #55ff55;
}

/* 按钮区域 */
.button-row {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
}

.action-btn {
    width: 30px;
    height: 30px;
    font-size: 20px;
    background-color: #555;
    color: white;
    border-radius: 5px;
    border-width: 0;
}

.action-btn:hover { background-color: #777; }
.action-btn:active { background-color: #999; }

/* 底部大按钮 */
.start-button {
    height: 60px;
    font-size: 30px;
    background-color: #4CAF50;
    color: white;
    border-radius: 10px;
    -unity-font-style: bold;
}

.start-button:disabled {
    background-color: #555;
    color: #888;
}