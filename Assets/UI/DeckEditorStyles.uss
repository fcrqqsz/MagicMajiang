/* 全局字体设置 */
.unity-text-element {
    -unity-font-definition: url('project://database/Assets/Font/MSYH.TTC');
    color: #eeeeee;
}

/* 全局容器设置 */
.main-container {
    flex-grow: 1;
    background-color: #222831; /* 深色背景 (Dark Gunmetal) */
    padding: 20px;
}

/* 顶部状态栏 */
.header-container {
    flex-direction: row;
    justify-content: space-between;
    height: 60px;
    margin-bottom: 20px;
    background-color: #393E46; /* 较浅的深色背景 */
    border-radius: 12px;
    padding: 0 20px;
    align-items: center;
    border-width: 0;
}

.header-stats {
    flex-direction: row;
    align-items: center;
}

.header-controls {
    flex-direction: row;
    align-items: center;
}

.stat-label {
    font-size: 20px;
    color: #EEEEEE;
    -unity-font-style: bold;
    margin-right: 20px;
}

.text-red { color: #ff6b6b; }
.text-green { color: #69f0ae; }
.text-white { color: #ffffff; }

/* 中间网格区域 */
.grid-scroll-view {
    flex-grow: 1;
    width: 100%;
    margin-bottom: 20px;
}

.main-grid {
    flex-direction: column;
}

.suit-row {
    flex-direction: row;
    align-items: center;
    background-color: #393E46; /* 与头部一致的背景色 */
    border-radius: 12px;
    margin-bottom: 30px; /* 1. 放大行间距 */
    padding: 15px;
    border-width: 0;
}

.suit-label {
    display: none; /* 隐藏标签占位 */
}

.grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    align-items: flex-start;
    flex-grow: 1;
    margin-left: 0;
}

.suit-controls {
    width: 120px;
    flex-direction: column;
    justify-content: center;
    padding-left: 10px;
    border-left-width: 0;
}

.control-btn {
    height: 40px; /* 增大按钮高度 */
    font-size: 24px; /* 增大字体大小 */
    background-color: #00ADB5; /* 蓝绿色 (Teal) */
    color: #EEEEEE;
    border-radius: 12px;
    margin: 4px 0;
    border-width: 0;
    transition-duration: 0.2s;
}
.control-btn:hover { 
    background-color: #00FFF5; /* 亮青色悬停 */
    color: #222831; 
}
.control-btn:active { background-color: #007E85; }

/* 全局控制按钮 (顶部) */
.header-controls .control-btn {
    width: 100px;
    margin-left: 10px;
    background-color: #00ADB5;
}

/* 牌项样式 */
.tile-item {
    width: 150px; /* 2. 增大卡片宽度 */
    height: 180px; /* 2. 增大卡片高度，给牌面更多空间 */
    margin: 10px;  /* 2. 增大左右间距 (四周都变大) */
    background-color: #222831; /* 深色背景，突出卡片感 */
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(0, 173, 181, 0.3); /* 微妙的青色边框 */
    align-items: center;
    justify-content: space-between;
    padding: 10px;
    transition-duration: 0.2s;
}

.tile-item:hover {
    border-color: #00FFF5; /* 亮青色边框模拟发光 */
    background-color: #2a323b; /* 背景稍微变亮 */
    scale: 1.02 1.02; /* 微微放大产生浮起感 */
}

.tile-face-image {
    flex-grow: 1;
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.tile-count {
    font-size: 24px; /* 字体加大 */
    color: #888;
    -unity-font-style: bold;
    min-width: 36px; /* 4. 预留2位数的空间 */
    -unity-text-align: middle-center; /* 文字居中 */
    margin: 0 2px;
}

.tile-count.active {
    color: #00ADB5; /* 使用主题色 */
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* 按钮区域 */
.button-row {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    align-items: center; /* 垂直居中对齐 */
    margin-top: 5px; /* 与上方图片的间距 */
}

.action-btn {
    width: 32px;
    height: 32px;
    font-size: 22px;
    -unity-font-style: bold;
    background-color: #393E46; /* 较浅的背景 */
    color: #EEEEEE;
    border-radius: 12px;
    border-width: 2px;
    border-color: #666;
    transition-duration: 0.2s;
}
.action-btn:hover { background-color: #00ADB5; color: #EEEEEE; }
.action-btn:active { background-color: #007E85; }

/* 底部大按钮 */
.start-button {
    height: 60px;
    font-size: 24px;
    background-color: #00ADB5; /* 使用主题色 */
    color: #EEEEEE;
    border-radius: 12px;
    -unity-font-style: bold;
    border-width: 0;
    transition-duration: 0.2s;
    margin-top: 0;
}
.start-button:hover { background-color: #00FFF5; color: #222831; }
.start-button:active { background-color: #007E85; }
.start-button:disabled {
    background-color: #393E46;
    color: #666;
}