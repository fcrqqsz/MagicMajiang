/* 全局字体设置 */
.unity-text-element {
    -unity-font-definition: url('project://database/Assets/Font/MSYH_UITK.asset');
    color: #eeeeee;
}

/* 全局容器设置 */
.main-container {
    flex-grow: 1;
    flex-direction: row;
    background-color: #222831; /* 深色背景 (Dark Gunmetal) */
    padding: 20px;
}

/* 编辑器主区域 */
.editor-area {
    flex-grow: 1;
    flex-direction: column;
}

/* 顶部状态栏 */
.header-container {
    flex-direction: row;
    justify-content: space-between;
    height: 60px;
    margin-bottom: 20px;
    background-color: #393E46; /* 较浅的深色背景 */
    border-radius: 12px;
    padding: 0 20px;
    align-items: center;
    border-width: 0;
}

.header-stats {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.header-controls {
    flex-direction: row;
    align-items: center;
}

.stat-label {
    font-size: 20px;
    color: #EEEEEE;
    -unity-font-style: bold;
    margin-right: 20px;
}

.text-red { color: #ff6b6b; }
.text-green { color: #69f0ae; }
.text-white { color: #ffffff; }

/* 中间网格区域 */
.grid-scroll-view {
    flex-grow: 1;
    width: 100%;
    margin-bottom: 20px;
}

.main-grid {
    flex-direction: column;
}

.suit-row {
    flex-direction: row;
    align-items: center;
    background-color: #393E46; /* 与头部一致的背景色 */
    border-radius: 12px;
    margin-bottom: 30px; /* 1. 放大行间距 */
    padding: 15px;
    border-width: 0;
}

.suit-label {
    display: none; /* 隐藏标签占位 */
}

.grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-content: flex-start;
    align-items: flex-start;
    flex-grow: 1;
    margin-left: 0;
}

.suit-controls {
    width: 120px;
    flex-direction: column;
    justify-content: center;
    padding-left: 10px;
    border-left-width: 0;
}

.control-btn {
    height: 40px; /* 增大按钮高度 */
    font-size: 24px; /* 增大字体大小 */
    background-color: #00ADB5; /* 蓝绿色 (Teal) */
    color: #EEEEEE;
    border-radius: 12px;
    margin: 4px 0;
    border-width: 0;
    transition-duration: 0.2s;
}
.control-btn:hover { 
    background-color: #00FFF5; /* 亮青色悬停 */
    color: #222831; 
}
.control-btn:active { background-color: #007E85; }

/* 全局控制按钮 (顶部) */
.header-controls .control-btn {
    width: 100px;
    margin-left: 10px;
    background-color: #00ADB5;
}

/* 牌项样式 */
.tile-item {
    width: 150px; /* 2. 增大卡片宽度 */
    height: 180px; /* 2. 增大卡片高度，给牌面更多空间 */
    margin: 10px;  /* 2. 增大左右间距 (四周都变大) */
    background-color: #222831; /* 深色背景，突出卡片感 */
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(0, 173, 181, 0.3); /* 微妙的青色边框 */
    align-items: center;
    justify-content: space-between;
    padding: 10px;
    transition-duration: 0.2s;
}

.tile-item:hover {
    border-color: #00FFF5; /* 亮青色边框模拟发光 */
    background-color: #2a323b; /* 背景稍微变亮 */
    scale: 1.02 1.02; /* 微微放大产生浮起感 */
}

.tile-face-image {
    flex-grow: 1;
    width: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.tile-count {
    font-size: 24px; /* 字体加大 */
    color: #888;
    -unity-font-style: bold;
    min-width: 36px; /* 4. 预留2位数的空间 */
    -unity-text-align: middle-center; /* 文字居中 */
    margin: 0 2px;
}

.tile-count.active {
    color: #00ADB5; /* 使用主题色 */
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* 按钮区域 */
.button-row {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    align-items: center; /* 垂直居中对齐 */
    margin-top: 5px; /* 与上方图片的间距 */
}

.action-btn {
    width: 32px;
    height: 32px;
    font-size: 22px;
    -unity-font-style: bold;
    background-color: #393E46; /* 较浅的背景 */
    color: #EEEEEE;
    border-radius: 12px;
    border-width: 2px;
    border-color: #666;
    transition-duration: 0.2s;
}
.action-btn:hover { background-color: #00ADB5; color: #EEEEEE; }
.action-btn:active { background-color: #007E85; }

/* 底部按钮容器 */
.footer-container {
    flex-direction: row;
    justify-content: space-between;
}

/* 底部按钮通用 */
.footer-btn {
    height: 60px;
    font-size: 24px;
    color: #EEEEEE;
    border-radius: 12px;
    -unity-font-style: bold;
    border-width: 0;
    transition-duration: 0.2s;
    flex-grow: 1;
}

/* 保存按钮 */
.footer-btn-save {
    background-color: #00ADB5;
    margin-right: 10px;
}
.footer-btn-save:hover { background-color: #00FFF5; color: #222831; }
.footer-btn-save:active { background-color: #007E85; }
.footer-btn-save:disabled {
    background-color: #393E46;
    color: #666;
}

/* 退出按钮 */
.footer-btn-exit {
    background-color: #393E46;
    margin-left: 10px;
}
.footer-btn-exit:hover { background-color: #555; color: #EEEEEE; }
.footer-btn-exit:active { background-color: #2a2e36; }

/* ======= 右侧牌库列表侧边栏 ======= */
.deck-sidebar {
    width: 320px;
    background-color: #393E46;
    border-radius: 12px;
    margin-left: 20px;
    padding: 16px;
    flex-direction: column;
}

.budget-inspector {
    flex-shrink: 0;
    background-color: #222831;
    border-radius: 12px;
    padding: 14px;
    margin-bottom: 14px;
}

.budget-title {
    color: #EEEEEE;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.budget-deck-name {
    color: #9aa6b2;
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-top: 3px;
}

.alienation-dial-host {
    width: 136px;
    height: 136px;
    align-self: center;
    justify-content: center;
    align-items: center;
    position: relative;
    margin-top: 8px;
}

.alienation-dial-value {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 52px;
    font-size: 22px;
    color: #EEEEEE;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.budget-preset-row {
    flex-direction: row;
    margin-top: 10px;
}

.budget-preset-button {
    flex-grow: 1;
    height: 34px;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 2px;
    padding-right: 2px;
    border-width: 0;
    border-radius: 7px;
    background-color: #393E46;
    color: #bfc5cc;
    font-size: 13px;
}

.budget-preset-button.selected {
    background-color: #00ADB5;
    color: #222831;
    -unity-font-style: bold;
}

.budget-breakdown {
    margin-top: 12px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 173, 181, 0.25);
}

.budget-breakdown-row,
.budget-breakdown-total {
    color: #bfc5cc;
    font-size: 13px;
    margin-top: 3px;
    white-space: normal;
}

.budget-breakdown-total {
    color: #EEEEEE;
    -unity-font-style: bold;
    margin-top: 7px;
}

.budget-status {
    color: #69f0ae;
    font-size: 13px;
    white-space: normal;
    margin-top: 10px;
    padding: 8px;
    border-radius: 7px;
    background-color: rgba(105, 240, 174, 0.08);
}

.budget-status.near-limit {
    color: #e9c267;
    background-color: rgba(233, 194, 103, 0.08);
}

.budget-status.over-limit {
    color: #ff6b6b;
    background-color: rgba(255, 107, 107, 0.08);
}

.sidebar-title {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #EEEEEE;
    margin-bottom: 12px;
}

.deck-list-scroll {
    flex-grow: 1;
}

.deck-list-container {
    flex-direction: column;
}

.deck-list-item {
    background-color: #222831;
    border-radius: 8px;
    border-width: 2px;
    border-color: transparent;
    padding: 10px 12px;
    margin-bottom: 8px;
    transition-duration: 0.15s;
}

.deck-list-item.selected {
    border-color: #00ADB5;
}

.deck-list-item:hover {
    border-color: rgba(0, 173, 181, 0.5);
}

.deck-item-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.deck-name-label {
    font-size: 18px;
    color: #EEEEEE;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-grow: 1;
}

.deck-name-field {
    font-size: 16px;
    flex-grow: 1;
    height: 28px;
    background-color: #1a1e26;
    color: #EEEEEE;
    border-radius: 4px;
    border-width: 1px;
    border-color: #00ADB5;
}

.deck-score-label {
    font-size: 14px;
    color: #888888;
    margin-top: 4px;
}

.btn-delete-deck {
    width: 28px;
    height: 28px;
    background-color: transparent;
    color: #888888;
    font-size: 18px;
    border-width: 0;
    border-radius: 4px;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.btn-delete-deck:hover {
    color: #ff6b6b;
    background-color: rgba(255, 107, 107, 0.15);
}

.btn-new-deck {
    height: 48px;
    font-size: 18px;
    -unity-font-style: bold;
    background-color: #00ADB5;
    color: #EEEEEE;
    border-radius: 12px;
    border-width: 0;
    margin-top: 12px;
    transition-duration: 0.2s;
}

.btn-new-deck:hover {
    background-color: #00FFF5;
    color: #222831;
}

.btn-new-deck:disabled {
    background-color: #393E46;
    color: #666;
}

/* ======= 天赋区域 ======= */
.talent-section {
    background-color: #393E46;
    border-radius: 12px;
    padding: 16px;
    margin-top: 16px;
}

.talent-section-header {
    font-size: 20px;
    -unity-font-style: bold;
    color: #EEEEEE;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

/* ======= 天赋选择弹窗 ======= */
.talent-picker-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
}

.talent-picker-panel {
    background-color: #222831;
    padding: 24px;
    border-radius: 16px;
    border-width: 2px;
    border-color: #00ADB5;
    min-width: 420px;
    max-width: 520px;
    max-height: 500px;
    flex-direction: column;
}

.talent-picker-title {
    font-size: 22px;
    color: #EEEEEE;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 173, 181, 0.3);
}

.talent-picker-scroll {
    max-height: 360px;
    flex-grow: 1;
}

.talent-picker-item {
    background-color: #393E46;
    border-radius: 10px;
    border-width: 2px;
    border-color: transparent;
    padding: 12px 16px;
    margin-bottom: 8px;
    -unity-text-align: middle-left;
    transition-duration: 0.15s;
    flex-direction: column;
}

.talent-picker-item:hover {
    border-color: #00ADB5;
    background-color: #444b56;
}

.talent-picker-item:active {
    background-color: #00ADB5;
    color: #222831;
}

.talent-picker-item.current-equipped {
    border-color: rgba(122, 90, 245, 0.6);
    opacity: 0.7;
}

.talent-picker-item-disabled {
    opacity: 0.42;
}

.talent-picker-item-reason {
    margin-top: 4px;
    color: #ff9b9b;
    font-size: 12px;
}

.talent-picker-item-name {
    font-size: 17px;
    color: #EEEEEE;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.talent-picker-item-desc {
    font-size: 13px;
    color: #aaaaaa;
    white-space: normal;
}

.talent-picker-item-meta {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}

.talent-picker-item-tier {
    font-size: 12px;
    -unity-font-style: bold;
}

.talent-picker-item-tier.tier-large {
    color: #f5a623;
}

.talent-picker-item-tier.tier-medium {
    color: #7a5af5;
}

.talent-picker-item-tier.tier-small {
    color: #4a9af5;
}

.talent-picker-item-cost {
    font-size: 12px;
    color: #ff6b6b;
}

.talent-picker-clear {
    background-color: rgba(255, 107, 107, 0.15);
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 107, 107, 0.3);
    padding: 10px 16px;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
    color: #ff6b6b;
    font-size: 16px;
}

.talent-picker-clear:hover {
    border-color: #ff6b6b;
    background-color: rgba(255, 107, 107, 0.25);
}

.talent-picker-cancel {
    height: 44px;
    font-size: 18px;
    background-color: #393E46;
    color: #EEEEEE;
    border-radius: 10px;
    border-width: 0;
    margin-top: 12px;
    transition-duration: 0.15s;
}

.talent-picker-cancel:hover {
    background-color: #555;
}

.talent-reserve-header { margin-top: 14px; }

.talent-slots-row {
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: stretch;
}

.talent-slot-separator {
    width: 2px;
    margin-left: 4px;
    margin-right: 4px;
    align-self: stretch;
    background-color: rgba(102, 102, 128, 0.8);
}

.talent-detail-label {
    margin-top: 8px;
    padding: 6px 10px;
    font-size: 12px;
    color: #cccccc;
    white-space: normal;
}

.unsaved-overlay {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.68);
    justify-content: center;
    align-items: center;
}

.unsaved-dialog {
    width: 440px;
    background-color: #222831;
    border-width: 2px;
    border-color: #00ADB5;
    border-radius: 14px;
    padding: 24px;
}

.unsaved-title {
    color: #EEEEEE;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.unsaved-message {
    color: #bfc5cc;
    font-size: 15px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 14px;
    margin-bottom: 20px;
}

.unsaved-actions {
    flex-direction: row;
    justify-content: center;
}

.unsaved-save,
.unsaved-discard,
.unsaved-cancel {
    width: 112px;
    height: 42px;
    margin-left: 5px;
    margin-right: 5px;
    border-width: 0;
    border-radius: 9px;
    color: #EEEEEE;
    font-size: 16px;
}

.unsaved-save { background-color: #00ADB5; }
.unsaved-discard { background-color: #9d4e53; }
.unsaved-cancel { background-color: #555b65; }
